<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/suggestions_card"
    android:background="@drawable/bg_rounded_8_gray200"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp">
    <TextView
        android:textAppearance="@style/TextAppearance.Body2Medium"
        android:textColor="@color/light_main"
        android:id="@+id/name_label"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:layout_constraintEnd_toStartOf="@+id/purchase_total_label"
        app:layout_constraintStart_toEndOf="@+id/icon_card"
        app:layout_constraintTop_toTopOf="@+id/icon_card"/>
</LinearLayout>
