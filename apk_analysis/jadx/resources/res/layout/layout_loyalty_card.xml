<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/basics100"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/employee_layout"
            android:background="@color/basics100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            <ImageView
                android:layout_width="33dp"
                android:layout_height="30dp"
                android:src="@drawable/img_employee_bird"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#979797"
                android:layout_gravity="center"
                android:id="@+id/employee_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="600"
                android:fontFamily="sans-serif"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:lineHeight="20px"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/employee_button"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_info_grey_20"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/primary_TextError"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/loyalty_card_card"
                android:background="@drawable/bg_rounded_10_white"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/code_image_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="4:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/card_points_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/code_image_view">
                    <ImageView
                        android:id="@+id/card_image_view"
                        android:layout_width="48dp"
                        android:layout_height="30dp"
                        android:src="@mipmap/img_loyalty_card"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/points_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_yellow_coin"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/basics700"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/points_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="1dp"
                                android:fontFamily="sans-serif"
                                android:layout_marginStart="4dp"
                                android:lineHeight="24px"
                                android:textFontWeight="700"/>
                            <TextView
                                android:textSize="10sp"
                                android:textColor="@color/textSecondary"
                                android:layout_gravity="top"
                                android:id="@+id/point_decimals_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:layout_marginStart="2dp"
                                android:lineHeight="14px"
                                android:textFontWeight="500"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/epoints_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp">
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_red_coin"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/basics700"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/epoints_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="1dp"
                                android:fontFamily="sans-serif"
                                android:layout_marginStart="4dp"
                                android:lineHeight="24px"
                                android:textFontWeight="700"/>
                            <TextView
                                android:textSize="10sp"
                                android:textColor="@color/textSecondary"
                                android:layout_gravity="top"
                                android:id="@+id/epoint_decimals_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:layout_marginStart="2dp"
                                android:lineHeight="14px"
                                android:textFontWeight="500"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/marks_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp">
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_loyalty_mark"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/basics700"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/marks_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="1dp"
                                android:fontFamily="sans-serif"
                                android:layout_marginStart="4dp"
                                android:lineHeight="24px"
                                android:textFontWeight="700"/>
                            <TextView
                                android:textSize="10sp"
                                android:textColor="@color/textSecondary"
                                android:layout_gravity="top"
                                android:id="@+id/mark_decimals_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:layout_marginStart="2dp"
                                android:lineHeight="14px"
                                android:textFontWeight="500"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/burning_layout"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_fire"
                android:layout_marginStart="20dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/basics700"
                android:ellipsize="end"
                android:id="@+id/burning_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:singleLine="true"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:layout_marginStart="8dp"
                android:lineHeight="20px"
                android:textFontWeight="400"/>
            <ImageView
                android:layout_width="6dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_small_chevron_right"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="25dp"/>
        </LinearLayout>
        <View
            android:id="@+id/separator"
            android:background="@color/gray200"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/delayed_points_layout"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_delayed_points"
                android:layout_marginStart="20dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/basics700"
                android:ellipsize="end"
                android:id="@+id/delayed_points_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:singleLine="true"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:layout_marginStart="8dp"
                android:lineHeight="20px"
                android:textFontWeight="400"/>
            <ImageView
                android:layout_width="6dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_small_chevron_right"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="25dp"/>
        </LinearLayout>
        <View
            android:id="@+id/separator2"
            android:background="@color/gray200"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/burning_marks_layout"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_loyalty_mark"
                android:layout_marginStart="20dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/basics700"
                android:ellipsize="end"
                android:id="@+id/burning_marks_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:singleLine="true"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:layout_marginStart="8dp"
                android:lineHeight="20px"
                android:textFontWeight="400"/>
            <ImageView
                android:layout_width="6dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_small_chevron_right"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="25dp"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/employee_info_layout"
        android:visibility="visible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="136dp"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/employee_info_layout_arrow"
            android:layout_width="18dp"
            android:layout_height="10dp"
            android:src="@drawable/img_arrow_popup"
            android:elevation="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/basics700"
            android:id="@+id/employee_info_text"
            android:background="@drawable/bg_rounded_8"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_weight="500"
            android:fontFamily="sans-serif"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:elevation="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
