<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/by_self_delivery_layout"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="top"
            android:id="@+id/order_detail_product_item_imageView"
            android:layout_width="71dp"
            android:layout_height="60dp"
            android:src="@mipmap/img_default"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/basics600"
                android:ellipsize="end"
                android:id="@+id/order_detail_product_item_name"
                android:layout_width="140dp"
                android:layout_height="60dp"
                android:maxLines="3"
                style="@style/DefaultLabel"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/modifications_list"
                android:paddingTop="8dp"
                android:scrollbars="none"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/basics600"
            android:layout_gravity="right"
            android:id="@+id/order_detail_product_item_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/basics450"
            android:layout_gravity="right"
            android:id="@+id/order_detail_product_item_priceInit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/basics450"
            android:layout_gravity="right"
            android:id="@+id/order_detail_product_item_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
