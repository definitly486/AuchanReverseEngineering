<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/basics600"
            android:ellipsize="end"
            android:id="@+id/stores_item_name"
            android:layout_width="233dp"
            android:layout_height="wrap_content"
            android:minHeight="22dp"
            android:maxLines="2"
            android:fontFamily="sans-serif"
            android:textFontWeight="500"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/navigation_arrow"
            android:layout_marginEnd="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/pin_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/ic_shops_location"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stores_item_name"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/gray600"
            android:ellipsize="end"
            android:id="@+id/stores_item_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="4"
            android:lineSpacingMultiplier="1.25"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/pin_icon"
            app:layout_constraintTop_toBottomOf="@+id/stores_item_name"/>
        <ImageView
            android:id="@+id/stores_item_schedule_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="11dp"
            android:src="@drawable/ic_shops_clock"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stores_item_address"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/gray600"
            android:ellipsize="end"
            android:id="@+id/stores_item_schedule"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="6"
            android:lineSpacingMultiplier="1.25"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/stores_item_schedule_icon"
            app:layout_constraintTop_toBottomOf="@+id/stores_item_address"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/working_status_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginStart="25dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stores_item_schedule">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/green_counter"
                android:id="@+id/working_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.25"
                android:layout_marginStart="0dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/gray600"
                android:id="@+id/working_status_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="•"
                android:lineSpacingMultiplier="1.25"
                android:layout_marginStart="6dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/light_main"
                android:id="@+id/working_status_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.25"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <p000auchan.TempWorkTimeView
            android:id="@+id/tempWorkTimeLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/working_status_layout"
            app:layout_constraintTop_toBottomOf="@+id/working_status_layout"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="12sp"
            android:id="@+id/build_route_button"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:textAllCaps="false"
            android:paddingHorizontal="12dp"
            android:textFontWeight="400"
            app:layout_constraintLeft_toLeftOf="@+id/stores_item_address"
            app:layout_constraintTop_toBottomOf="@+id/tempWorkTimeLayout"
            style="@style/DefaultGreenMaterialRoundButtonM"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/stores_item_distanse_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="48dp"
            app:layout_constraintBottom_toBottomOf="@+id/build_route_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/build_route_button">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_shops_route"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/gray600"
                android:id="@+id/stores_item_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:background="@color/separatorColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"/>
</LinearLayout>
