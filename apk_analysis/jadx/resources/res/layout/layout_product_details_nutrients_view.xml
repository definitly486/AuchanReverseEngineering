<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/basics100"
    android:layout_width="match_parent"
    android:layout_height="82dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/round_corners_8"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/textSecondary"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif"
            android:lineHeight="14dp"
            android:textFontWeight="500"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/proteins_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/basics700"
                    android:id="@+id/proteins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:lineHeight="24dp"
                    android:textFontWeight="600"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/basics700"
                    android:id="@+id/proteins_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:lineHeight="14dp"
                    android:textFontWeight="500"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/fats_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/basics700"
                    android:id="@+id/fats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:lineHeight="24dp"
                    android:textFontWeight="600"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/basics700"
                    android:id="@+id/fats_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:lineHeight="14dp"
                    android:textFontWeight="500"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/carbs_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/basics700"
                    android:id="@+id/carbs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:lineHeight="24dp"
                    android:textFontWeight="600"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/basics700"
                    android:id="@+id/carbs_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:lineHeight="14dp"
                    android:textFontWeight="500"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/calories_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/basics700"
                    android:id="@+id/calories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:lineHeight="24dp"
                    android:textFontWeight="600"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/basics700"
                    android:id="@+id/calories_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:lineHeight="14dp"
                    android:textFontWeight="500"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
