<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="visible"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/red_orange"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp">
    <androidx.cardview.widget.CardView
        android:background="@color/basics100"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="1dp"
        app:cardCornerRadius="8dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/points_image"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="21dp"
                android:src="@drawable/ic_checkout_points_gray"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:text="Списание баллов"
                app:layout_constraintLeft_toRightOf="@+id/points_image"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/available_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="Доступно 1 200 из 4 508"
                app:layout_constraintLeft_toRightOf="@+id/points_image"
                app:layout_constraintTop_toBottomOf="@+id/title_text"/>
            <ImageView
                android:id="@+id/info_image"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_info_grey_filled"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/available_text"
                app:layout_constraintStart_toEndOf="@+id/available_text"
                app:layout_constraintTop_toTopOf="@+id/available_text"/>
            <TextView
                android:textColor="#ff8731"
                android:id="@+id/burning_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="56 баллов сгорят 13.09"
                app:layout_constraintLeft_toRightOf="@+id/points_image"
                app:layout_constraintTop_toBottomOf="@+id/available_text"/>
            <ImageView
                android:id="@+id/hide_image"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="21dp"
                android:layout_marginRight="16dp"
                android:src="@drawable/ic_checkout_minus"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="20dp"
                app:boxBackgroundColor="@null"
                app:boxBackgroundMode="filled"
                app:layout_constraintTop_toBottomOf="@+id/burning_text"
                style="@style/DefaultInputLayout.Grey.NoBottomLine">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center_vertical"
                    android:id="@+id/edit_text"
                    android:background="@color/basics150"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="asdasdasd"
                    android:inputType="number"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/points_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="5dp"
                android:progress="10"
                android:progressTint="@color/green_primary"
                android:thumbTint="@color/gray400"
                app:layout_constraintTop_toBottomOf="@+id/input_layout"/>
            <TextView
                android:id="@+id/points_start_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                android:text="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="@+id/points_seekbar"
                app:layout_constraintTop_toBottomOf="@+id/points_seekbar"/>
            <TextView
                android:id="@+id/points_end_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginRight="10dp"
                android:text="1200"
                app:layout_constraintRight_toRightOf="@+id/points_seekbar"
                app:layout_constraintTop_toBottomOf="@+id/points_seekbar"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.cardview.widget.CardView>
