<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="10dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/backgroundLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/gray_chateau"
            android:layout_gravity="center_vertical"
            android:id="@+id/products_quantity_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/paymentMethodImage"
            app:layout_constraintTop_toBottomOf="@+id/paymentMethodName"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/gray_chateau"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/dot_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/products_quantity_text_view"
            app:layout_constraintStart_toEndOf="@+id/products_quantity_text_view"
            app:layout_constraintTop_toTopOf="@+id/products_quantity_text_view"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/gray_chateau"
            android:layout_gravity="center_vertical"
            android:id="@+id/products_price_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/dot_text_view"
            app:layout_constraintStart_toEndOf="@+id/dot_text_view"
            app:layout_constraintTop_toTopOf="@+id/dot_text_view"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/paymentMethodImage"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/basics600"
            android:layout_gravity="center_vertical"
            android:id="@+id/paymentMethodName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toTopOf="@+id/products_quantity_text_view"
            app:layout_constraintStart_toEndOf="@+id/paymentMethodImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
