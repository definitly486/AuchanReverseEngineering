<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:contentInsetStart="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/back_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/ToolbarImageButton.Back"/>
            <TextView
                android:textAppearance="@style/TextAppearance.Title"
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Завершение"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/pricePanel"
                android:background="@drawable/background_grey_rect"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:id="@+id/totalTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:text="Итого к оплате:"
                    app:layout_constraintBottom_toTopOf="@+id/discountTextView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:id="@+id/discountTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Без учета скидок"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/totalTextView"
                    style="@style/InfoTextView"/>
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#009656"
                    android:id="@+id/totalPriceTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="323 405.85 Р"
                    app:layout_constraintBottom_toBottomOf="@+id/discountTextView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/totalTextView"/>
                <View
                    android:id="@+id/separator"
                    android:background="#d7d9dc"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/discountTextView"/>
                <ImageView
                    android:id="@+id/iconInfo"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="11dp"
                    android:src="@drawable/ic_info"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/separator"/>
                <TextView
                    android:textSize="10sp"
                    android:id="@+id/balancePromt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Итоговая стоимость отобразится на терминале"
                    app:layout_constraintBottom_toBottomOf="@+id/iconInfo"
                    app:layout_constraintStart_toEndOf="@+id/iconInfo"
                    app:layout_constraintTop_toTopOf="@+id/iconInfo"
                    style="@style/InfoTextView"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <crc64fac7521b55e1fcf3.SnackView
                android:id="@+id/loyalty_snackLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cellBackground="@drawable/bg_snack_blue"
                app:cellIcon="@drawable/ic_info_blue"
                app:cellTextColor="@color/basics500"/>
            <ImageView
                android:id="@+id/auchanPayBackground"
                android:layout_width="153dp"
                android:layout_height="118dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/ic_ss_pay"/>
            <TextView
                android:textColor="@color/basics450"
                android:gravity="center_horizontal"
                android:id="@+id/barcodeDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:text="Поднесите штрих-код к сканеру\10терминала оплаты товара"
                android:lineSpacingExtra="3sp"
                style="@style/InfoTextView"/>
            <ImageView
                android:id="@+id/barcodeImage"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/background_grey_rect"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/barcodeTextCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
