<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cellLayout"
        android:background="@color/white"
        android:paddingTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:id="@+id/cartItemLogo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.25"/>
        <androidx.appcompat.widget.AppCompatCheckBox
            android:gravity="top|left"
            android:id="@+id/itemSelected"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/toggle_selector_green"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toStartOf="@+id/cartItemLogo"
            app:layout_constraintTop_toTopOf="@+id/cartItemLogo"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/salesLayout"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            app:flow_horizontalAlign="start"
            app:layout_constraintStart_toStartOf="@+id/cartItemTitle"
            app:layout_constraintTop_toTopOf="parent">
            <p000auchan.BadgesView
                android:id="@+id/badgesLayout"
                android:layout_width="wrap_content"
                android:layout_height="20dp"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/basics700"
            android:ellipsize="end"
            android:id="@+id/cartItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:maxLines="3"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/favorite_button"
            app:layout_constraintStart_toEndOf="@+id/cartItemLogo"
            app:layout_constraintTop_toBottomOf="@+id/salesLayout"/>
        <ImageView
            android:id="@+id/favorite_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:id="@+id/cartPricePerItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="0dp"
            android:layout_marginStart="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cartItemLogo"
            app:layout_constraintTop_toBottomOf="@+id/cartItemTitle"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/modifications_list"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cartItemLogo"
            app:layout_constraintTop_toBottomOf="@+id/cartPricePerItem"/>
        <include
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/cartItemLogo"
            app:layout_constraintLeft_toLeftOf="@+id/cartItemLogo"
            app:layout_constraintRight_toRightOf="@+id/cartItemLogo"
            app:layout_constraintTop_toTopOf="@+id/cartItemLogo"
            layout="@layout/layout_adults_overlay"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/basics700"
            android:id="@+id/cartItemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@+id/cartItemLogo"
            app:layout_constraintTop_toBottomOf="@+id/modifications_list"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:id="@+id/old_price_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/cartItemPrice"
            app:layout_constraintStart_toEndOf="@+id/cartItemPrice"/>
        <View
            android:id="@+id/old_price_crossing_line"
            android:background="@color/monza"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:rotation="-18"
            app:layout_constraintBottom_toBottomOf="@+id/old_price_label"
            app:layout_constraintEnd_toEndOf="@+id/old_price_label"
            app:layout_constraintStart_toStartOf="@+id/old_price_label"
            app:layout_constraintTop_toTopOf="@+id/old_price_label"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/promoInfoLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:flow_horizontalAlign="start"
            app:layout_constraintStart_toStartOf="@+id/cartItemPrice"
            app:layout_constraintTop_toBottomOf="@+id/cartItemPrice">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:layout_gravity="center_vertical"
                android:id="@+id/discount_end_date"
                android:layout_width="wrap_content"
                android:layout_height="14dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/primary400"
                android:layout_gravity="center_vertical"
                android:id="@+id/discount_by_loyalty_program"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/markedProductCardView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:backgroundTint="@color/alertLightWarning"
            app:cardCornerRadius="8dp"
            app:layout_constraintStart_toEndOf="@+id/cartItemLogo"
            app:layout_constraintTop_toBottomOf="@+id/promoInfoLayout">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="5dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_status_info_fill"
                    android:layout_marginHorizontal="1dp"
                    app:tint="@color/alertWarning"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.SubtextMedium"
                    android:textColor="@color/text_warning"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/markedProductTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cartIncDecLayout"
            android:background="@color/gray200"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="16dp"
            app:cardBackgroundColor="@color/gray200"
            app:cardCornerRadius="10dp"
            app:layout_constraintStart_toEndOf="@+id/cartItemLogo"
            app:layout_constraintTop_toBottomOf="@+id/markedProductCardView">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp">
                <ImageButton
                    android:id="@+id/cartDecreaseButton"
                    android:padding="6dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/minus_button_selector"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/basics700"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/cartItemCount"
                    android:layout_width="60dp"
                    android:layout_height="match_parent"
                    android:singleLine="true"/>
                <ImageButton
                    android:id="@+id/cartIncreaseButton"
                    android:padding="6dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/plus_button_selector"
                    android:scaleType="fitCenter"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <ImageView
            android:id="@+id/cart_delete_icon"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_trash_cart"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/cartIncDecLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cartIncDecLayout"/>
        <FrameLayout
            android:id="@+id/comment_layout"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cartItemLogo"
            app:layout_constraintTop_toBottomOf="@+id/cartIncDecLayout">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/comment_default_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="10dp">
                <ImageView
                    android:id="@+id/checkbox"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_toggle_active"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/basics600"
                    android:gravity="center_vertical"
                    android:id="@+id/checkbox_title"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/comment_input_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                app:hintEnabled="false"
                style="@style/DefaultInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:textColor="@color/black"
                    android:id="@+id/comment_input"
                    android:paddingTop="22dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>
            <crc64fac7521b55e1fcf3.SkottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/comment_progress_view"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="10dp"
                app:skottie_autoPlay="true"
                app:skottie_fileName="selfscan_loading_indicator.json"
                app:skottie_loop="true"/>
        </FrameLayout>
        <View
            android:id="@+id/separator"
            android:background="@color/catskill_white"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/comment_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
