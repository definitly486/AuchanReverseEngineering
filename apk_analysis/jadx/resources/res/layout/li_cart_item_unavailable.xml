<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cellLayout"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/cartItemLogo"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.5"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.25"/>
            <include
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/cartItemLogo"
                app:layout_constraintLeft_toLeftOf="@+id/cartItemLogo"
                app:layout_constraintRight_toRightOf="@+id/cartItemLogo"
                app:layout_constraintTop_toTopOf="@+id/cartItemLogo"
                layout="@layout/layout_adults_overlay"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/salesLayout"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                app:flow_horizontalAlign="start"
                app:layout_constraintStart_toStartOf="@+id/cartItemTitle"
                app:layout_constraintTop_toTopOf="parent">
                <p000auchan.BadgesView
                    android:id="@+id/badgesLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/basics700"
                android:ellipsize="end"
                android:id="@+id/cartItemTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:maxLines="3"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@+id/favorite_button"
                app:layout_constraintStart_toEndOf="@+id/cartItemLogo"
                app:layout_constraintTop_toBottomOf="@+id/salesLayout"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/findReplacement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/gray200"
                app:cardCornerRadius="8dp"
                app:layout_constraintBottom_toTopOf="@+id/separator"
                app:layout_constraintStart_toStartOf="@+id/cartItemTitle"
                app:layout_constraintTop_toBottomOf="@+id/cartItemTitle">
                <TextView
                    android:textAppearance="@style/TextAppearance.SubtextMedium"
                    android:textColor="@color/light_main"
                    android:id="@+id/findReplacementText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="9dp"/>
            </com.google.android.material.card.MaterialCardView>
            <ImageView
                android:id="@+id/favorite_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/cart_delete_icon"
                android:padding="8dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_trash_cart"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/findReplacement"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/findReplacement"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/separator"
            android:background="@color/catskill_white"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"/>
    </LinearLayout>
</LinearLayout>
