<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/section_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="22dp"
        android:text="Мои предложения"
        android:maxLines="2"
        android:includeFontPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextAppearance.Title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        app:layout_constraintBottom_toBottomOf="@+id/section_title"
        app:layout_constraintStart_toEndOf="@+id/section_title"
        app:layout_constraintTop_toTopOf="@+id/section_title">
        <View
            android:id="@+id/indicator_backround"
            android:background="@drawable/round_corners_7_red"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/basics100"
            android:id="@+id/indicator_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:text="2 новых"
            android:alpha="10"
            app:layout_constraintBottom_toBottomOf="@+id/indicator_backround"
            app:layout_constraintEnd_toEndOf="@+id/indicator_backround"
            app:layout_constraintStart_toStartOf="@+id/indicator_backround"
            app:layout_constraintTop_toTopOf="@+id/indicator_backround"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ui_brand"
        android:id="@+id/all_items_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Все"
        android:includeFontPadding="false"
        android:drawablePadding="10dp"
        android:textAllCaps="false"
        android:drawableEnd="@drawable/ic_chevron_right_green"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/section_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/section_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bannersRecyclerView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/section_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
