<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <EditText
        android:textColor="@null"
        android:id="@+id/input_field"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:cursorVisible="false"
        android:inputType="number"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:id="@+id/pin_first_edit_text"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/pin_second_edit_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/PinEditText"/>
    <View
        android:id="@+id/pin_first_cursor"
        android:background="@drawable/pin_entry_cursor"
        android:visibility="gone"
        android:layout_width="2dp"
        android:layout_height="24dp"
        android:layout_marginStart="5dp"
        app:layout_constraintStart_toStartOf="@+id/pin_first_edit_text"
        app:layout_constraintTop_toTopOf="@+id/pin_first_edit_text"/>
    <EditText
        android:id="@+id/pin_second_edit_text"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/pin_third_edit_text"
        app:layout_constraintStart_toEndOf="@+id/pin_first_edit_text"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/PinEditText"/>
    <View
        android:id="@+id/pin_second_cursor"
        android:background="@drawable/pin_entry_cursor"
        android:visibility="gone"
        android:layout_width="2dp"
        android:layout_height="24dp"
        android:layout_marginStart="5dp"
        app:layout_constraintStart_toStartOf="@+id/pin_second_edit_text"
        app:layout_constraintTop_toTopOf="@+id/pin_second_edit_text"/>
    <EditText
        android:id="@+id/pin_third_edit_text"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/pin_fourth_edit_text"
        app:layout_constraintStart_toEndOf="@+id/pin_second_edit_text"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/PinEditText"/>
    <View
        android:id="@+id/pin_third_cursor"
        android:background="@drawable/pin_entry_cursor"
        android:visibility="gone"
        android:layout_width="2dp"
        android:layout_height="24dp"
        android:layout_marginStart="5dp"
        app:layout_constraintStart_toStartOf="@+id/pin_third_edit_text"
        app:layout_constraintTop_toTopOf="@+id/pin_third_edit_text"/>
    <EditText
        android:id="@+id/pin_fourth_edit_text"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/pin_third_edit_text"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/PinEditText"/>
    <View
        android:id="@+id/pin_fourth_cursor"
        android:background="@drawable/pin_entry_cursor"
        android:visibility="gone"
        android:layout_width="2dp"
        android:layout_height="24dp"
        android:layout_marginStart="5dp"
        app:layout_constraintStart_toStartOf="@+id/pin_fourth_edit_text"
        app:layout_constraintTop_toTopOf="@+id/pin_fourth_edit_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
