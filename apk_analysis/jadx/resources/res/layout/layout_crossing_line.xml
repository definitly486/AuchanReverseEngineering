<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/basics500"
        android:id="@+id/crossing_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/crossing_line"
        android:background="@color/torch_red"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:rotation="-4"
        app:layout_constraintBottom_toBottomOf="@+id/crossing_label"
        app:layout_constraintEnd_toEndOf="@+id/crossing_label"
        app:layout_constraintStart_toStartOf="@+id/crossing_label"
        app:layout_constraintTop_toTopOf="@+id/crossing_label"/>
</androidx.constraintlayout.widget.ConstraintLayout>
