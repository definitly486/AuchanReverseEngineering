<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p000auchan.TooltipDrawerView
        android:id="@+id/tooltip_drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cornerRadius="@dimen/loyalty_card_corners_size"
        app:overlayColor="#db000000"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/default_layout"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/start_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="20dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/end_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="20dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="17sp"
            android:textColor="@color/white"
            android:id="@+id/progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/skip_button"
            app:layout_constraintStart_toStartOf="@+id/start_guideline"
            app:layout_constraintTop_toTopOf="@+id/skip_button"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="17sp"
            android:textColor="#909090"
            android:id="@+id/skip_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/end_guideline"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TransparentMaterialButton"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/top_header_icon"
            android:layout_width="98dp"
            android:layout_height="79dp"
            app:layout_constraintBottom_toTopOf="@+id/header_layout"
            app:layout_constraintStart_toStartOf="@+id/start_guideline"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/header_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toTopOf="@+id/description"
            app:layout_constraintEnd_toEndOf="@+id/end_guideline"
            app:layout_constraintStart_toStartOf="@+id/start_guideline">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/header_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="9dp"
                android:layout_marginEnd="5dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/basics100"
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="17sp"
            android:textColor="@color/white"
            android:id="@+id/description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:lineSpacingExtra="2sp"
            app:layout_constraintBottom_toTopOf="@+id/continue_button"
            app:layout_constraintEnd_toEndOf="@+id/end_guideline"
            app:layout_constraintStart_toStartOf="@+id/start_guideline"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="17sp"
            android:textColor="@color/black"
            android:id="@+id/continue_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:rippleColor="@color/rippleColor"
            style="@style/DefaultMaterialButton"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tooltip_card_layout"
            android:background="@drawable/bg_rounded_12"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="60dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/tooltip_card_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="15dp"
                android:src="@drawable/ic_arrow_tooltip"
                android:layout_marginStart="17dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/basics700"
                android:id="@+id/tooltip_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif"
                android:layout_marginStart="60dp"
                android:layout_marginEnd="24dp"
                android:textFontWeight="700"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/basics700"
                android:id="@+id/tooltip_card_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:layout_marginStart="60dp"
                android:layout_marginEnd="24dp"
                android:textFontWeight="400"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tooltip_card_title"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textColor="@color/basics100"
                android:id="@+id/tooltip_card_button"
                android:background="@drawable/bg_rounded_8_green"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:textAllCaps="false"
                android:layout_marginStart="60dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tooltip_card_description"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tooltip_fav_cats_layout"
            android:background="@drawable/bg_rounded_12"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toTopOf="@+id/tooltip_fav_cats_cell"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/basics700"
                android:id="@+id/tooltip_fav_cats_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:textFontWeight="700"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/basics700"
                android:id="@+id/tooltip_fav_cats_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:textFontWeight="400"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tooltip_fav_cats_title"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textColor="@color/basics100"
                android:id="@+id/tooltip_fav_cats_button"
                android:background="@drawable/bg_rounded_8_green"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:textAllCaps="false"
                android:layout_marginStart="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tooltip_fav_cats_description"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/tooltip_fav_cats_arrow"
            android:visibility="gone"
            android:layout_width="109dp"
            android:layout_height="110dp"
            android:layout_marginTop="0dp"
            android:src="@drawable/tooltip_fav_cats_arrow"
            android:layout_marginStart="153dp"
            app:layout_constraintStart_toStartOf="@+id/tooltip_fav_cats_layout"
            app:layout_constraintTop_toBottomOf="@+id/tooltip_fav_cats_layout"/>
        <ImageView
            android:id="@+id/tooltip_fav_cats_cell"
            android:visibility="gone"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginBottom="40dp"
            android:src="@drawable/tooltip_fav_cats_cell"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
