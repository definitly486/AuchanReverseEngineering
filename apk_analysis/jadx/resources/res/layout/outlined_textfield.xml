<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/textInputLayoutBackground"
        android:background="@drawable/bg_outlined_text"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/textInputLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp"
            app:errorTextAppearance="@style/TextAppearance.PrimaryErrorTextInput"
            app:hintAnimationEnabled="false"
            app:hintEnabled="true"
            app:hintTextColor="@color/basics450"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_outlined_text_hint"
                android:id="@+id/upperHint"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="ErrorMessage"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayoutBackground"/>
            <EditText
                android:textSize="16sp"
                android:textColor="@color/basics700"
                android:textColorHint="@color/text_secondary"
                android:gravity="center_vertical"
                android:id="@+id/textInputEditText"
                android:background="@null"
                android:padding="0dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="6dp"
                android:text="5478"
                android:hint="bubu"
                android:inputType="number"
                android:fontFamily="sans-serif"
                android:translationZ="-2dp"
                android:backgroundTint="@color/textfield_states_colors"
                android:paddingVertical="0dp"
                android:focusedByDefault="false"
                android:textFontWeight="400"/>
        </LinearLayout>
        <ImageButton
            android:id="@+id/textInputButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:src="@drawable/ic_close_dark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageButton
            android:id="@+id/errorButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:src="@drawable/ic_warning_red"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/redButtonColor"
        android:id="@+id/textfieldErrorMessage"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        android:layout_marginRight="7dp"
        android:text="ErrorMessage"
        app:layout_constraintTop_toBottomOf="@+id/textInputLayoutBackground"/>
</androidx.constraintlayout.widget.ConstraintLayout>
