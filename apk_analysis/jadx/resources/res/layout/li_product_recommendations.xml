<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="162dp"
    android:layout_height="302dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="10dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/last_item_state"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/green_primary"
            app:cardCornerRadius="12dp">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                app:cardCornerRadius="12dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:layout_marginBottom="12dp"
                        android:src="@drawable/arrow_right"
                        app:layout_constraintBottom_toTopOf="@+id/show_all_text"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <TextView
                        android:textColor="@color/green_primary"
                        android:id="@+id/show_all_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Показать всё"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </androidx.cardview.widget.CardView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/default_item_state"
            android:paddingTop="0dp"
            android:paddingBottom="10dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/favorite_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/salesLayout"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <p000auchan.BadgesView
                    android:id="@+id/badgesLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/product_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintDimensionRatio="142:88"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/salesLayout"/>
            <p000auchan.HighlightedTextView
                android:textSize="12sp"
                android:id="@+id/hint_label"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextAppearance.NoMoreGoods"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/basics600"
                android:ellipsize="end"
                android:id="@+id/title_label"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="25dp"
                android:maxLines="3"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/product_image"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/price_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintBottom_toTopOf="@+id/adding_block_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/promoLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintBottom_toTopOf="@+id/price_label"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/primary400"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/discount_by_loyalty_program"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/discount_end_date"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/basics700"
                    android:id="@+id/price_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toTopOf="@+id/weight_goods_per_unit"
                    app:layout_constraintStart_toStartOf="parent"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/old_price_label"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/price_label"
                    app:layout_constraintStart_toEndOf="@+id/price_label"/>
                <View
                    android:id="@+id/old_price_crossing_line"
                    android:background="@color/monza"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:rotation="-18"
                    app:layout_constraintBottom_toBottomOf="@+id/old_price_label"
                    app:layout_constraintEnd_toEndOf="@+id/old_price_label"
                    app:layout_constraintStart_toStartOf="@+id/old_price_label"
                    app:layout_constraintTop_toTopOf="@+id/old_price_label"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/weight_goods_per_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/price_label"
                    app:layout_constraintVertical_bias="0.5"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/adding_block_view"
                android:clipChildren="false"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/default_state_view"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/action_clickable_view"
                        android:background="@drawable/bg_rounded_9"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">
                        <TextView
                            android:textSize="12dp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:text="В корзину"
                            android:textFontWeight="500"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/adding_state_view"
                    android:background="@drawable/bg_rounded_8_gray200"
                    android:clipChildren="false"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/decrease_button"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/recommendations_minus_button_selector"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:id="@+id/count_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintEnd_toStartOf="@+id/increase_button"
                        app:layout_constraintStart_toEndOf="@+id/decrease_button"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/basics600"
                        android:id="@+id/price_sub_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/increase_button"
                        app:layout_constraintStart_toEndOf="@+id/decrease_button"
                        app:layout_constraintTop_toBottomOf="@+id/count_label"/>
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/increase_button"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/recommendations_plus_button_selector"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/basics700"
                android:id="@+id/out_of_stock_text"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginBottom="0dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
