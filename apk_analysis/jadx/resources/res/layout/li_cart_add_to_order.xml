<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="15dp"
    android:backgroundTint="@color/gray200"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/startGuideLine"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_begin="12dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/endGuideLine"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_end="12dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/iconVerticalGuideLine"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_end="20dp"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Medium"
            android:textColor="@color/light_main"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toStartOf="@+id/iconVerticalGuideLine"
            app:layout_constraintStart_toStartOf="@+id/startGuideLine"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageButton
            android:id="@+id/icon"
            android:padding="10dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_status_info_fill"
            android:scaleType="fitXY"
            android:layout_marginEnd="22dp"
            app:layout_constraintBottom_toBottomOf="@+id/title"
            app:layout_constraintEnd_toEndOf="@+id/iconVerticalGuideLine"
            app:layout_constraintStart_toEndOf="@+id/iconVerticalGuideLine"
            app:layout_constraintTop_toTopOf="@+id/title"
            app:tint="@color/gray600"/>
        <TextView
            android:textAppearance="@style/TextAppearance.SubtextMedium"
            android:textColor="@color/textSecondary"
            android:id="@+id/description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="@+id/endGuideLine"
            app:layout_constraintStart_toStartOf="@+id/startGuideLine"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <Button
            android:id="@+id/button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/endGuideLine"
            app:layout_constraintStart_toStartOf="@+id/startGuideLine"
            style="@style/DefaultGreenMaterialRoundButtonS"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
