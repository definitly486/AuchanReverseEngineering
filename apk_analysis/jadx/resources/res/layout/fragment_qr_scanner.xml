<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p000auchan.p001Android.SelfScan.AuchanBarcodeView
        android:id="@+id/barcodeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:focusRoundedCornerRadius="15dp"
        app:focusStrokeWidth="5dp"
        app:layoutCornersRadius="23dp"
        app:layoutCornersSide="bottomLeft|bottomRight"
        app:layoutMaskPaddingBottom="65dp"
        app:viewfinder_mask="#b3000000"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <ToggleButton
            android:id="@+id/torchButton"
            android:background="@drawable/ic_torch_selector"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:textOn=""
            android:textOff=""
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/headerTextView"
            app:layout_constraintEnd_toStartOf="@+id/headerTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/headerTextView"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/headerTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Заголовок"
            app:layout_constraintEnd_toStartOf="@+id/closeButton"
            app:layout_constraintHorizontal_weight="5"
            app:layout_constraintStart_toEndOf="@+id/torchButton"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/closeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/headerTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/headerTextView"
            app:layout_constraintTop_toTopOf="@+id/headerTextView"
            app:srcCompat="@drawable/ic_close"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/subHeaderTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="35dp"
            android:text="Подзаголовок"
            app:layout_constraintBottom_toTopOf="@+id/focusImage"
            app:layout_constraintEnd_toEndOf="@+id/focusImage"
            app:layout_constraintStart_toStartOf="@+id/focusImage"/>
        <View
            android:id="@+id/focusImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.8"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/freeWifiTextView"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="65dp"
            android:text="Бесплатный Wi-Fi"
            android:drawablePadding="7dp"
            android:drawableStart="@drawable/ic_wifi"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p000auchan.p001Android.SelfScan.UITestBarcodeInputView
        android:layout_gravity="center"
        android:id="@+id/uITestBarcodeInputView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <include
        android:id="@+id/progressLayout"
        android:visibility="gone"
        layout="@layout/progress"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
