<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shapeAppearance="@style/TopCornersShape">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/defaultLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/puller"
                android:layout_width="36dp"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/ic_chevron_down_close_bottomsheet"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.core.widget.NestedScrollView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:overScrollMode="never"
                app:layout_constraintBottom_toTopOf="@+id/close_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/puller">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/title_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextAppearance.Title"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/no_internet_image"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:tint="@color/red_orange"
                        android:layout_marginStart="26dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/no_internet_title_text"
                        app:layout_constraintEnd_toStartOf="@+id/no_internet_title_text"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/no_internet_title_text"
                        app:srcCompat="@drawable/ic_alert"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/red_orange"
                        android:ellipsize="end"
                        android:id="@+id/no_internet_title_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:maxLines="1"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="52dp"
                        android:layout_marginEnd="21dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/title_text"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/basics450"
                        android:id="@+id/no_internet_description_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:lineSpacingExtra="4dp"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="52dp"
                        android:layout_marginEnd="21dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/no_internet_title_text"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/red_orange"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/blocked_card_text"
                        android:visibility="invisible"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:maxLines="1"
                        android:layout_marginStart="36dp"
                        android:layout_marginEnd="36dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/no_internet_description_text"
                        app:layout_goneMarginTop="64dp"/>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_container_outer"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        app:cardBackgroundColor="#e53232"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:layout_constraintDimensionRatio="335:87"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/blocked_card_text">
                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_container_inner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="3dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            app:cardBackgroundColor="#ffffff"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:layout_constraintDimensionRatio="335:87"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/blocked_card_text">
                            <ImageView
                                android:id="@+id/qr_image"
                                android:background="@android:color/transparent"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"/>
                            <ImageView
                                android:id="@+id/qr_block_overlay_view"
                                android:background="@color/white"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:alpha="0.75"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"/>
                        </androidx.cardview.widget.CardView>
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/defaultLabelTextColor"
                        android:ellipsize="end"
                        android:id="@+id/card_number_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:maxLines="1"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:textFontWeight="600"
                        app:layout_constraintBottom_toTopOf="@+id/card_number"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/card_container_outer"/>
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/defaultLabelTextColor"
                        android:id="@+id/card_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:textFontWeight="500"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/card_number_label"/>
                    <View
                        android:id="@+id/scroll_bottom_inset"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/card_number"/>
                    <androidx.constraintlayout.widget.Group
                        android:id="@+id/no_internet_group"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:constraint_referenced_ids="no_internet_image, no_internet_title_text, no_internet_description_text"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/close_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginBottom="42dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/DefaultGreenMaterialRoundButton"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:id="@+id/progressLayout"
            android:visibility="gone"
            layout="@layout/progress"/>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
