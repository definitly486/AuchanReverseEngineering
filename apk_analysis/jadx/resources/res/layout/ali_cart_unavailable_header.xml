<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/itemsUnavailableHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/itemsUnavailableHeaderTopMargin"
            android:layout_width="0dp"
            android:layout_height="19dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18sp"
            android:id="@+id/itemsUnavailableHeaderText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:text="Нет в наличии"
            android:includeFontPadding="false"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/itemsUnavailableClearButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/itemsUnavailableHeaderTopMargin"
            style="@style/NavigationSectionHeader"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Medium"
            android:textColor="@color/primary_TextError"
            android:id="@+id/itemsUnavailableClearButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/itemsUnavailableHeaderText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/itemsUnavailableHeaderText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
