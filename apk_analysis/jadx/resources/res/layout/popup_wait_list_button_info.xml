<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_text_container"
        android:background="@drawable/bg_rounded_8_gray900"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/basics100"
            android:id="@+id/title_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/basics100"
            android:id="@+id/content_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/triangle_view"
        android:background="@drawable/bg_up_triangle_gray900"
        android:layout_width="21dp"
        android:layout_height="15dp"
        android:transformPivotX="10.5dp"
        android:transformPivotY="6dp"
        android:rotation="180"/>
</LinearLayout>
