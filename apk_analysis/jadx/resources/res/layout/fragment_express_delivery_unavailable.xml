<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/basics100"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="20dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/select_another_receiving_method_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/express_delivery_unavailable_image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:src="@drawable/img_express_delivery_unavailable"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@null"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Subhead2Bold"
            android:textColor="@color/light_main"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Medium"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:id="@+id/actionDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/select_another_receiving_method_button"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/DefaultGreenMaterialRoundButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
