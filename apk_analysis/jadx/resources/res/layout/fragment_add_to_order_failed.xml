<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="36dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/startGuideLine"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="20dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/endGuideLine"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_end="20dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/middleHorizontalGuideLine"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.5"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/puller"
        android:paddingBottom="4dp"
        android:layout_width="36dp"
        android:layout_height="9dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/bottom_sheet_line"
        app:layout_constraintEnd_toEndOf="@+id/endGuideLine"
        app:layout_constraintStart_toStartOf="@+id/startGuideLine"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/closeButton"
        android:background="@android:color/transparent"
        android:padding="10dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="13dp"
        android:src="@drawable/ic_close_light"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/middleLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/middleHorizontalGuideLine"
        app:layout_constraintEnd_toEndOf="@+id/endGuideLine"
        app:layout_constraintStart_toStartOf="@+id/startGuideLine"
        app:layout_constraintTop_toTopOf="@+id/middleHorizontalGuideLine">
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/img_add_to_order_failed"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Subhead2Bold"
            android:textColor="@color/light_main"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAlignment="center"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Regular"
            android:textColor="@color/textSecondary"
            android:gravity="center"
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAlignment="center"/>
    </LinearLayout>
    <Button
        android:id="@+id/doneButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/endGuideLine"
        app:layout_constraintStart_toStartOf="@+id/startGuideLine"
        style="@style/DefaultGreenMaterialRoundButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
