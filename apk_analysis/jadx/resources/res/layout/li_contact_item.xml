<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <ImageView
        android:id="@+id/backgroundInitials"
        android:background="@drawable/img_contact_background"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/oslo_gray"
        android:gravity="center"
        android:id="@+id/initialsTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="ФИ"
        app:layout_constraintBottom_toBottomOf="@+id/backgroundInitials"
        app:layout_constraintLeft_toLeftOf="@+id/backgroundInitials"
        app:layout_constraintRight_toRightOf="@+id/backgroundInitials"
        app:layout_constraintTop_toTopOf="@+id/backgroundInitials"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/black"
        android:id="@+id/fullNameTextView"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:text="Фамилия и имя"
        app:layout_constraintLeft_toRightOf="@+id/backgroundInitials"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/backgroundInitials"/>
    <TextView
        android:id="@+id/phoneTextView"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginLeft="16dp"
        android:text="+7 999 99 99 999"
        app:layout_constraintBottom_toBottomOf="@+id/backgroundInitials"
        app:layout_constraintLeft_toRightOf="@+id/backgroundInitials"
        app:layout_constraintRight_toRightOf="parent"/>
    <View
        android:background="@color/basics400"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginRight="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/phoneTextView"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
