<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/icon_card"
        android:layout_width="42dp"
        android:layout_height="42dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"/>
    </com.google.android.material.card.MaterialCardView>
    <TextView
        android:textAppearance="@style/TextAppearance.Body2Medium"
        android:textSize="14sp"
        android:textColor="@color/light_main"
        android:id="@+id/name_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="110dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon_card"
        app:layout_constraintTop_toTopOf="@+id/icon_card"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Body2Medium"
        android:textSize="14sp"
        android:textColor="@color/light_main"
        android:id="@+id/purchase_total_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/name_label"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Body2Regular"
        android:textSize="12sp"
        android:textColor="@color/gray600"
        android:id="@+id/time_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@+id/name_label"
        app:layout_constraintTop_toBottomOf="@+id/name_label"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/points_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/purchase_total_label">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/basics700"
            android:id="@+id/stamps_value_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/stamps_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ic_loyalty_mark"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/black"
            android:id="@+id/points_value_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/points_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ic_loyalty_point"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/black"
            android:id="@+id/express_points_value_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/epoints_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ic_loyalty_e_point"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/big_points_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/points_layout">
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Medium"
            android:textSize="14sp"
            android:textColor="@color/light_main"
            android:id="@+id/big_stamps_value_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/big_stamps_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ic_loyalty_mark"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Medium"
            android:textSize="14sp"
            android:textColor="@color/basics600"
            android:id="@+id/big_points_value_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/big_points_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ic_loyalty_point"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Medium"
            android:textSize="14sp"
            android:textColor="@color/light_main"
            android:id="@+id/big_epoints_value_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/big_epoints_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ic_loyalty_e_point"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
