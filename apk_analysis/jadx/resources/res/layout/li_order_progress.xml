<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="68dp"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/background"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:backgroundTint="@color/ui_brand"
        app:cardCornerRadius="19dp"
        app:cardElevation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/image"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/basics100"/>
    </androidx.cardview.widget.CardView>
    <View
        android:id="@+id/left"
        android:background="@color/ui_brand"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="-3dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/background"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/right"
        android:background="@color/ui_brand"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginLeft="-3dp"
        android:layout_marginTop="14dp"
        app:layout_constraintLeft_toRightOf="@+id/background"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.HintMedium"
        android:textSize="10sp"
        android:gravity="center"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="68dp"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/background"/>
</androidx.constraintlayout.widget.ConstraintLayout>
