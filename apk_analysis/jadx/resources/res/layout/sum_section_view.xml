<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/round_corners_8"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/catskill_white">
    <TextView
        android:textColor="@color/basics500"
        android:id="@+id/sum_title"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="16dp"
        android:text="Сумма"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/basics700"
        android:id="@+id/sum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="322.45Р"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sum_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/added_line"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sum">
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Regular"
            android:textColor="@color/basics500"
            android:id="@+id/added_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/added_epoints_label"
            app:layout_constraintStart_toEndOf="@+id/added_section_title"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Medium"
            android:textColor="@color/basics700"
            android:gravity="center"
            android:id="@+id/added_epoints_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="6dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/added_section_title"
            app:layout_constraintEnd_toStartOf="@+id/added_epoints_image"
            app:layout_constraintStart_toEndOf="@+id/spacer"/>
        <ImageView
            android:id="@+id/added_epoints_image"
            android:background="@drawable/ic_loyalty_e_point"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/added_epoints_label"
            app:layout_constraintEnd_toStartOf="@+id/added_points_label"
            app:layout_constraintStart_toEndOf="@+id/added_epoints_label"
            app:layout_constraintTop_toTopOf="@+id/added_epoints_label"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Medium"
            android:textColor="@color/basics700"
            android:gravity="center"
            android:id="@+id/added_points_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="6dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/added_section_title"
            app:layout_constraintEnd_toStartOf="@+id/added_points_image"
            app:layout_constraintStart_toEndOf="@+id/added_epoints_image"/>
        <ImageView
            android:id="@+id/added_points_image"
            android:background="@drawable/ic_loyalty_point"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/added_points_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/added_points_label"
            app:layout_constraintTop_toTopOf="@+id/added_points_label"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/delayed_points_layout"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/added_line">
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Regular"
            android:textColor="@color/basics500"
            android:id="@+id/delayed_points_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/delayed_points_info_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_info"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/delayed_points_title"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/delayed_points_value"
            app:layout_constraintStart_toEndOf="@+id/delayed_points_info_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Medium"
            android:textColor="@color/basics700"
            android:id="@+id/delayed_points_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/delayed_points_title"
            app:layout_constraintEnd_toStartOf="@+id/delayed_points_icon"/>
        <ImageView
            android:id="@+id/delayed_points_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_delayed_points"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/delayed_points_value"
            app:layout_constraintEnd_toStartOf="@+id/delayed_points_time"
            app:layout_constraintTop_toTopOf="@+id/delayed_points_value"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Medium"
            android:textColor="@color/basics700"
            android:id="@+id/delayed_points_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBaseline_toBaselineOf="@+id/delayed_points_value"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/spended_line"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/delayed_points_layout">
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Regular"
            android:textColor="@color/basics500"
            android:id="@+id/spended_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/spended_epoints_label"
            app:layout_constraintStart_toEndOf="@+id/spended_section_title"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Medium"
            android:textColor="@color/red_orange"
            android:id="@+id/spended_epoints_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="6dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/spended_section_title"
            app:layout_constraintEnd_toStartOf="@+id/spended_epoints_image"
            app:layout_constraintStart_toEndOf="@+id/spacer"/>
        <ImageView
            android:id="@+id/spended_epoints_image"
            android:background="@drawable/ic_loyalty_e_point"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/spended_points_label"
            app:layout_constraintStart_toEndOf="@+id/spended_epoints_label"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Medium"
            android:textColor="@color/red_orange"
            android:id="@+id/spended_points_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="6dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/spended_section_title"
            app:layout_constraintEnd_toStartOf="@+id/spended_points_image"
            app:layout_constraintStart_toEndOf="@+id/spended_epoints_image"/>
        <ImageView
            android:id="@+id/spended_points_image"
            android:background="@drawable/ic_loyalty_point"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/spended_points_label"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/stamps_line"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spended_line">
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Regular"
            android:textColor="@color/basics500"
            android:id="@+id/stamps_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/spended_stamps_label"
            app:layout_constraintStart_toEndOf="@+id/stamps_section_title"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Medium"
            android:textColor="@color/red_orange"
            android:id="@+id/spended_stamps_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:maxLines="1"
            app:layout_constraintBaseline_toBaselineOf="@+id/stamps_section_title"
            app:layout_constraintEnd_toStartOf="@+id/added_stamps_image"
            app:layout_constraintStart_toEndOf="@+id/spacer"/>
        <ImageView
            android:id="@+id/added_stamps_image"
            android:background="@drawable/ic_loyalty_mark"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/added_stamps_label"
            app:layout_constraintStart_toEndOf="@+id/spended_stamps_label"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Medium"
            android:textColor="@color/basics700"
            android:id="@+id/added_stamps_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:maxLines="1"
            android:layout_marginStart="7dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/stamps_section_title"
            app:layout_constraintEnd_toStartOf="@+id/spended_stamps_image"
            app:layout_constraintStart_toEndOf="@+id/added_stamps_image"/>
        <ImageView
            android:id="@+id/spended_stamps_image"
            android:background="@drawable/ic_loyalty_mark"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/added_stamps_label"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
