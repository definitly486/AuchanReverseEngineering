<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/custom_ripple"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/navigation_cell_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginLeft="20dp"/>
        <TextView
            android:ellipsize="end"
            android:gravity="top|left"
            android:layout_gravity="center_vertical"
            android:id="@+id/navigation_cell_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="13dp"
            android:layout_weight="1"
            android:textAlignment="gravity"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            style="@style/NavigationCellTextStyle"/>
        <crc64fac7521b55e1fcf3.CounterBadgeView
            android:layout_gravity="center_vertical"
            android:id="@+id/navigation_cell_unread_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="18dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="6dp"
            android:layout_height="12dp"
            android:layout_marginRight="28dp"
            android:src="@drawable/ic_small_chevron_right"/>
    </LinearLayout>
    <View
        android:id="@+id/navigation_cell_separator"
        android:background="@color/separatorColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
