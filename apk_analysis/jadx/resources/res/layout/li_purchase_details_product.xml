<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/by_self_delivery_layout"
    android:paddingTop="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="top"
        android:id="@+id/order_detail_product_item_imageView"
        android:layout_width="71dp"
        android:layout_height="50dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/img_product_empty"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/primary02_TextActive"
        android:ellipsize="end"
        android:id="@+id/order_detail_product_item_name"
        android:layout_width="162dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:maxHeight="60dp"
        android:minHeight="40dp"
        android:maxLines="3"
        app:layout_constraintLeft_toRightOf="@+id/order_detail_product_item_imageView"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DefaultLabel"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/gray900"
        android:layout_gravity="right"
        android:id="@+id/order_detail_product_item_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/order_detail_product_item_price">
        <com.google.android.material.card.MaterialCardView
            android:layout_gravity="right"
            android:id="@+id/purchase_points"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:backgroundTint="#f4f5f7"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingHorizontal="4dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/light_main"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/purchase_points_value"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="2dp"
                    android:src="@drawable/ic_loyalty_point"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_gravity="right"
            android:id="@+id/express_purchase_points"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:backgroundTint="#f4f5f7"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingHorizontal="4dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/light_main"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/express_purchase_points_value"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="2dp"
                    android:src="@drawable/ic_loyalty_e_point"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_gravity="right"
            android:id="@+id/purchase_stamps"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:backgroundTint="#f4f5f7"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingHorizontal="4dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/light_main"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/purchase_stamps_value"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginLeft="3.5dp"
                    android:layout_marginRight="1.5dp"
                    android:src="@drawable/ic_loyalty_mark"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/textSecondary"
        android:layout_gravity="left"
        android:id="@+id/order_detail_product_item_qty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:layout_constraintLeft_toLeftOf="@+id/order_detail_product_item_name"
        app:layout_constraintTop_toBottomOf="@+id/order_detail_product_item_imageView"/>
    <View
        android:id="@+id/item_divider"
        android:background="@color/basics200"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/order_detail_product_item_qty"/>
</androidx.constraintlayout.widget.ConstraintLayout>
