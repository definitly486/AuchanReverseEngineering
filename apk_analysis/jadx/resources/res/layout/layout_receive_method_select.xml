<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/basics200"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/empty_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textAppearance="@style/TextAppearance.SubtextMedium"
            android:textColor="@color/gray900"
            android:gravity="center"
            android:id="@+id/empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:text="Чтобы смотреть актуальные цены, укажите адрес\10доставки или магазин самовывоза"
            android:layout_marginStart="41dp"
            android:layout_marginEnd="41dp"/>
        <com.google.android.material.button.MaterialButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/select_button"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Выбрать адрес"
            style="@style/DefaultGreenMaterialRoundButtonXS"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/default_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/basics600"
            android:ellipsize="start"
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="52dp"
            android:textFontWeight="500"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/notifications_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="18dp"
        android:src="@drawable/ic_bell_black"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/favorite_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_favorite_empty_black"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@+id/notifications_button"
        app:layout_constraintTop_toTopOf="@+id/notifications_button"/>
    <TextView
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/notifications_badge"
        android:background="@drawable/bg_notification_unread_dot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="-6dp"
        android:minWidth="16dp"
        android:includeFontPadding="false"
        android:layout_marginEnd="-6dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="@+id/notifications_button"
        app:layout_constraintTop_toTopOf="@+id/notifications_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
