<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/startGuideLine"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="20dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/endGuideLine"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_end="20dp"/>
    <FrameLayout
        android:id="@+id/closeButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="11dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close_modal_opaque"/>
    </FrameLayout>
    <TextView
        android:textAppearance="@style/TextAppearance.Subhead2Bold"
        android:textColor="@color/light_main"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@+id/endGuideLine"
        app:layout_constraintStart_toStartOf="@+id/startGuideLine"
        app:layout_constraintTop_toBottomOf="@+id/closeButton"/>
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/privacyDataConsentCheckbox"
        android:background="#00ffffff"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/privacyDataConsentTextView"
        app:layout_constraintStart_toStartOf="@+id/startGuideLine"
        app:layout_constraintTop_toTopOf="@+id/privacyDataConsentTextView"
        app:theme="@style/MaterialCheckboxGreen"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Body1Regular"
        android:textColor="@color/light_main"
        android:id="@+id/privacyDataConsentTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="@+id/endGuideLine"
        app:layout_constraintStart_toEndOf="@+id/privacyDataConsentCheckbox"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/CheckBoxTextSignup"/>
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/wantReceiveCheckbox"
        android:background="#00ffffff"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/wantReceiveTextView"
        app:layout_constraintStart_toStartOf="@+id/startGuideLine"
        app:layout_constraintTop_toTopOf="@+id/wantReceiveTextView"
        app:theme="@style/MaterialCheckboxGreen"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Body1Regular"
        android:textColor="@color/light_main"
        android:id="@+id/wantReceiveTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/stretch"
        app:layout_constraintEnd_toEndOf="@+id/endGuideLine"
        app:layout_constraintStart_toEndOf="@+id/wantReceiveCheckbox"
        app:layout_constraintTop_toBottomOf="@+id/privacyDataConsentTextView"
        style="@style/CheckBoxTextSignup"/>
    <View
        android:id="@+id/stretch"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/signUpButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wantReceiveTextView"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/signUpButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/endGuideLine"
        app:layout_constraintStart_toStartOf="@+id/startGuideLine"
        app:layout_constraintTop_toBottomOf="@+id/stretch"
        style="@style/DefaultGreenMaterialRoundButtonM"/>
</androidx.constraintlayout.widget.ConstraintLayout>
