<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/left_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/info_image"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_info_light_grey_filled_24"
                android:layout_marginEnd="12dp"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/category_image_container"
                android:clipChildren="true"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginVertical="12dp"
                app:cardBackgroundColor="@color/gray200"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">
                <ImageView
                    android:id="@+id/category_image"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Regular"
            android:textColor="@color/light_main"
            android:gravity="center_vertical"
            android:id="@+id/category_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:lines="3"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/right_container"
            app:layout_constraintStart_toEndOf="@+id/left_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/right_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textAppearance="@style/TextAppearance.SubtextMedium"
                android:textColor="@color/ui_brand"
                android:gravity="center"
                android:id="@+id/cashback_text"
                android:background="@drawable/bg_rounded_12"
                android:layout_width="41dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/alertLightGreen"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"/>
            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkbox"
                android:background="@android:color/transparent"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:checked="false"
                android:button="@drawable/toggle_selector_green"
                android:layout_marginStart="12dp"/>
            <ImageView
                android:id="@+id/chevron"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right_grey"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <View
            android:background="@color/gray200"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
