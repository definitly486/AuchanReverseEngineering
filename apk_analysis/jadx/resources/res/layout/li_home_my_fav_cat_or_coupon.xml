<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="140dp"
    android:layout_height="140dp">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/background"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/basics700"
                android:ellipsize="end"
                android:gravity="start"
                android:layout_gravity="start"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxLines="2"
                android:singleLine="false"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:lineHeight="20dp"
                android:textFontWeight="500"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/textSecondary"
                android:ellipsize="end"
                android:gravity="start"
                android:layout_gravity="start"
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:singleLine="false"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:lineHeight="14dp"
                android:textFontWeight="400"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <Button
                android:textSize="11sp"
                android:id="@+id/button"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:textFontWeight="500"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/DefaultGreenMaterialRoundButton"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/textSecondary"
                android:gravity="start"
                android:id="@+id/time_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:lineHeight="14dp"
                android:textFontWeight="400"
                app:layout_constraintBottom_toTopOf="@+id/button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <FrameLayout
                android:id="@+id/categories_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <FrameLayout
                    android:id="@+id/category_1_layout"
                    android:background="@drawable/round_corners_18"
                    android:clipChildren="true"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/category_1_background"
                        android:clipChildren="true"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        app:cardBackgroundColor="@color/basics100"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:id="@+id/category_1_plus"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="6dp"
                            android:src="@drawable/ic_plus_green"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"/>
                        <ImageView
                            android:id="@+id/category_1_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/category_2_layout"
                    android:background="@drawable/round_corners_18"
                    android:clipChildren="true"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="38dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/category_2_background"
                        android:clipChildren="true"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        app:cardBackgroundColor="@color/basics100"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:id="@+id/category_2_plus"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="6dp"
                            android:src="@drawable/ic_plus_green"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"/>
                        <ImageView
                            android:id="@+id/category_2_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/category_3_layout"
                    android:background="@drawable/round_corners_18"
                    android:clipChildren="true"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="64dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/category_3_background"
                        android:clipChildren="true"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        app:cardBackgroundColor="@color/basics100"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:id="@+id/category_3_plus"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="6dp"
                            android:src="@drawable/ic_plus_green"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"/>
                        <ImageView
                            android:id="@+id/category_3_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/n_category_layout"
                    android:background="@drawable/round_corners_18"
                    android:visibility="gone"
                    android:clipChildren="true"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="90dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <FrameLayout
                        android:id="@+id/n_category_background"
                        android:background="@drawable/round_corners_16"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/count_text"
                            android:background="@color/ui_brand"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:textFontWeight="500"/>
                    </FrameLayout>
                </FrameLayout>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <FrameLayout
        android:id="@+id/indicator"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:translationX="-4dp"
        android:translationY="-4dp"
        app:layout_constraintLeft_toLeftOf="@+id/background"
        app:layout_constraintTop_toTopOf="@+id/background">
        <View
            android:id="@+id/indicator_background"
            android:background="@drawable/rounded_corners_5_white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:background="@drawable/rounded_corners_4_red"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginLeft="1dp"
            android:layout_marginTop="1dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
