<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="10dp"
    android:paddingBottom="30dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <ImageView
        android:id="@+id/bottomSheetLine"
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:src="@drawable/bottom_sheet_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="left"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginRight="5dp"
        android:text="Ручной ввод"
        app:layout_constraintEnd_toStartOf="@+id/closeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomSheetLine"
        style="@style/TextAppearance.Title"/>
    <ImageView
        android:id="@+id/closeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_close_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/enterBarcodeLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_bias="0">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/barcodeInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Штрих-код товара"
            app:endIconMode="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/DefaultInputLayout.Grey">
            <com.google.android.material.textfield.TextInputEditText
                android:textColor="@color/black"
                android:id="@+id/barcodeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLength="13"
                android:inputType="numberDecimal"
                android:paddingEnd="100dp"
                android:importantForAutofill="no"/>
        </com.google.android.material.textfield.TextInputLayout>
        <ImageView
            android:id="@+id/clear_button"
            android:background="@drawable/ic_dark_close_cross"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/barcodeInputLayout"
            app:layout_constraintEnd_toEndOf="@+id/barcodeInputLayout"
            app:layout_constraintTop_toTopOf="@+id/barcodeInputLayout"/>
        <Button
            android:textSize="16sp"
            android:id="@+id/add_barcode_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Готово"
            android:backgroundTint="@color/green_material_button_active_selector"
            app:layout_constraintEnd_toEndOf="@+id/barcodeInputLayout"
            app:layout_constraintStart_toStartOf="@+id/barcodeInputLayout"
            app:layout_constraintTop_toBottomOf="@+id/barcodeInputLayout"
            style="@style/DefaultMaterialButton"/>
        <crc64fac7521b55e1fcf3.SkottieAnimationView
            android:id="@+id/loadingIndicatorView"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/barcodeInputLayout"
            app:layout_constraintEnd_toEndOf="@+id/barcodeInputLayout"
            app:layout_constraintTop_toTopOf="@+id/barcodeInputLayout"
            app:skottie_autoPlay="true"
            app:skottie_fileName="selfscan_loading_indicator.json"
            app:skottie_loop="true"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
