<?xml version="1.0" encoding="utf-8"?>
<com.zerobranch.layout.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:draggedItem="@+id/cellLayout"
    app:isFreeDragAfterOpen="false"
    app:rightItem="@+id/backgroundLayout"
    app:swipeDirection="left">
    <LinearLayout
        android:layout_gravity="end"
        android:id="@+id/backgroundLayout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/removeLayout"
            android:background="#ff3b2f"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_trash"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"/>
        </FrameLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/removeViewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/basics450"
            android:gravity="center"
            android:id="@+id/removeTextView"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Карта удалена!"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cellLayout"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="#2c2f33"
            android:id="@+id/cardPanText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="13dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/cardSchemeIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="spread"
            style="@style/DefaultLabel"/>
        <ImageView
            android:id="@+id/cardSchemeIcon"
            android:layout_width="46dp"
            android:layout_height="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="20dp"
            android:src="@drawable/ic_mir"
            android:backgroundTint="@color/primary400"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/separator"
            android:background="@color/catskill_white"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.zerobranch.layout.SwipeLayout>
