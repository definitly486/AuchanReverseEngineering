<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_text_input_layout"
    android:paddingTop="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="10dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="8dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/basics450"
        android:id="@+id/text_with_ok_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/text_with_ok_button_ok_layout"
        android:paddingLeft="8dp"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintTop_toTopOf="parent">
        <Button
            android:textSize="12sp"
            android:textColor="@color/basics100"
            android:id="@+id/text_with_ok_button_ok"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:layout_width="60dp"
            android:layout_height="46dp"
            android:textAllCaps="false"
            android:backgroundTint="@color/green_material_button_selector"
            app:cornerRadius="8dp"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/basics100"
            android:id="@+id/cancel_button"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="46dp"
            android:textAllCaps="false"
            android:backgroundTint="@color/green_material_button_selector"
            app:cornerRadius="8dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/close_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:src="@drawable/ic_close_dark"
        app:layout_constraintBottom_toBottomOf="@+id/text_with_ok_button_ok_layout"
        app:layout_constraintEnd_toStartOf="@+id/text_with_ok_button_ok_layout"
        app:layout_constraintTop_toTopOf="@+id/text_with_ok_button_ok_layout"/>
    <ImageView
        android:id="@+id/ok_info"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="8dp"
        android:src="@drawable/ic_info_grey_filled"
        app:layout_constraintBottom_toBottomOf="@+id/text_with_ok_button_ok_layout"
        app:layout_constraintEnd_toStartOf="@+id/close_button"
        app:layout_constraintTop_toTopOf="@+id/text_with_ok_button_ok_layout"/>
    <ImageView
        android:id="@+id/ok_image"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:src="@drawable/ic_ok_green_on_white"
        app:layout_constraintBottom_toBottomOf="@+id/text_with_ok_button_ok_layout"
        app:layout_constraintEnd_toStartOf="@+id/ok_info"
        app:layout_constraintTop_toTopOf="@+id/text_with_ok_button_ok_layout"/>
    <ImageView
        android:id="@+id/error_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:src="@drawable/ic_info_red"
        app:layout_constraintBottom_toBottomOf="@+id/text_with_ok_button_ok_layout"
        app:layout_constraintEnd_toStartOf="@+id/ok_image"
        app:layout_constraintTop_toTopOf="@+id/text_with_ok_button_ok_layout"/>
    <EditText
        android:textSize="16sp"
        android:textColor="@color/basics600"
        android:id="@+id/text_with_ok_input"
        android:background="@null"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginRight="13dp"
        android:maxLines="1"
        android:imeOptions="actionDone"
        app:layout_constraintBottom_toBottomOf="@+id/text_with_ok_button_ok_layout"
        app:layout_constraintEnd_toStartOf="@+id/error_info"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/text_with_ok_hint"/>
    <View
        android:id="@+id/bottom_line"
        android:background="@color/basics200"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_with_ok_button_ok_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
