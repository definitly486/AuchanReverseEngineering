<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white_lilac"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="20dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="20dp"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/totalHeaderText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Итого"
        app:layout_constraintBottom_toTopOf="@+id/adult_warning_message_snack_view"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <crc64fac7521b55e1fcf3.SnackView
        android:id="@+id/adult_warning_message_snack_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        app:cellBackground="@drawable/bg_snack_warning"
        app:cellIcon="@drawable/ic_warning_orange"
        app:cellTextColor="@color/brown"
        app:layout_constraintBottom_toTopOf="@+id/totalItemsPriceText"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/totalHeaderText"/>
    <TextView
        android:id="@+id/totalItemsPriceText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toStartOf="@+id/totalItemsPrice"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/adult_warning_message_snack_view"
        style="@style/DescriptionLabel"/>
    <TextView
        android:gravity="right"
        android:id="@+id/totalItemsPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        android:drawableEnd="@drawable/vd_expand_round"
        app:layout_constraintBottom_toBottomOf="@+id/totalItemsPriceText"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintTop_toTopOf="@+id/totalItemsPriceText"
        style="@style/DescriptionLabel"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/adultsReservedLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/totalItemsPriceText">
        <View
            android:id="@+id/expanded_price_details_top_divider_view"
            android:background="@color/iron"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:alpha="0.5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/cart_products_price_title_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintBottom_toTopOf="@+id/reserved_items_price_title_text_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/expanded_price_details_top_divider_view"
            style="@style/DescriptionLabel"/>
        <TextView
            android:gravity="right"
            android:id="@+id/cart_products_price_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/cart_products_price_title_text_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cart_products_price_title_text_view"
            style="@style/DescriptionLabel"/>
        <TextView
            android:id="@+id/reserved_items_price_title_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cart_products_price_title_text_view"
            style="@style/DescriptionLabel"/>
        <TextView
            android:gravity="right"
            android:id="@+id/reserved_items_price_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/reserved_items_price_title_text_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/reserved_items_price_title_text_view"
            style="@style/DescriptionLabel"/>
        <View
            android:id="@+id/expanded_price_details_bottom_divider_view"
            android:background="@color/iron"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:alpha="0.5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/reserved_items_price_title_text_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/totalItemsWeightText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toStartOf="@+id/totalItemsWeight"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/adultsReservedLayout"
        style="@style/DescriptionLabel"/>
    <TextView
        android:gravity="right"
        android:id="@+id/totalItemsWeight"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/totalItemsWeightText"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintTop_toTopOf="@+id/totalItemsWeightText"
        style="@style/DescriptionLabel"/>
    <TextView
        android:id="@+id/total_discount_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        app:cellTextColor="@color/basics500"
        app:layout_constraintEnd_toStartOf="@+id/total_discount"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/totalItemsWeightText"
        style="@style/DescriptionLabel"/>
    <TextView
        android:textColor="@color/green_haze"
        android:gravity="right"
        android:id="@+id/total_discount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/total_discount_title"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintTop_toTopOf="@+id/total_discount_title"
        style="@style/DescriptionLabel"/>
    <TextView
        android:id="@+id/promocode_discount_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        app:cellTextColor="@color/basics500"
        app:layout_constraintEnd_toStartOf="@+id/total_discount"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/total_discount_title"
        style="@style/DescriptionLabel"/>
    <TextView
        android:textColor="@color/green_haze"
        android:gravity="right"
        android:id="@+id/promocode_discount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/promocode_discount_title"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintTop_toTopOf="@+id/promocode_discount_title"
        style="@style/DescriptionLabel"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/discount_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/points_payment_layout"
        app:layout_constraintEnd_toStartOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/promocode_discount_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/points_payment_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/discount_list">
        <TextView
            android:id="@+id/points_payment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cellTextColor="@color/basics500"
            app:layout_constraintBottom_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"
            style="@style/DescriptionLabel"/>
        <TextView
            android:textColor="@color/basics500"
            android:id="@+id/points_payment_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/points_payment_title"
            app:layout_constraintEnd_toStartOf="@+id/points_payment_icon"
            app:layout_constraintTop_toTopOf="@+id/points_payment_title"
            style="@style/DescriptionLabel"/>
        <ImageView
            android:id="@+id/points_payment_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_coins_payment_total"
            app:layout_constraintBottom_toBottomOf="@+id/points_payment_value"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/points_payment_value"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/stamps_withdraw_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/points_payment_layout">
        <TextView
            android:textColor="@color/basics700"
            android:id="@+id/stamps_withdraw_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"
            style="@style/CartLabelInfo"/>
        <TextView
            android:textColor="@color/basics700"
            android:id="@+id/stamps_withdraw_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/stamps_withdraw_title"
            app:layout_constraintEnd_toStartOf="@+id/stamps_withdraw_icon"
            app:layout_constraintTop_toTopOf="@+id/stamps_withdraw_title"
            style="@style/CartLabelInfo"/>
        <ImageView
            android:id="@+id/stamps_withdraw_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_stamps_withdraw"
            app:layout_constraintBottom_toBottomOf="@+id/stamps_withdraw_value"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/stamps_withdraw_value"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/basics700"
        android:id="@+id/totalOrderPriceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/discout_total_divider"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/stamps_withdraw_layout"
        style="@style/CartLabelInfo"/>
    <TextView
        android:textColor="@color/basics700"
        android:gravity="right"
        android:id="@+id/totalOrderPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/totalOrderPriceText"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintTop_toTopOf="@+id/totalOrderPriceText"
        style="@style/CartLabelInfo"/>
    <View
        android:id="@+id/discout_total_divider"
        android:background="@color/iron"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/pickingPriceText"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/totalOrderPriceText"/>
    <TextView
        android:id="@+id/pickingPriceText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/surgeAmountText"
        app:layout_constraintEnd_toStartOf="@+id/pickingPrice"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/discout_total_divider"
        app:layout_goneMarginTop="10dp"
        style="@style/DescriptionLabel"/>
    <TextView
        android:textColor="@color/basics500"
        android:gravity="right"
        android:id="@+id/pickingPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/pickingPriceText"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintTop_toTopOf="@+id/pickingPriceText"
        style="@style/DescriptionLabel"/>
    <TextView
        android:id="@+id/surgeAmountText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/deliveryPriceText"
        app:layout_constraintEnd_toStartOf="@+id/surgeAmount"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/pickingPriceText"
        style="@style/DescriptionLabel"/>
    <TextView
        android:textColor="@color/basics500"
        android:gravity="right"
        android:id="@+id/surgeAmount"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/surgeAmountText"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintTop_toTopOf="@+id/surgeAmountText"
        style="@style/DescriptionLabel"/>
    <TextView
        android:id="@+id/deliveryPriceText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/totalPriceText"
        app:layout_constraintEnd_toStartOf="@+id/deliveryPriceContainer"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/surgeAmountText"
        style="@style/DescriptionLabel"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/deliveryPriceContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/deliveryPriceText"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintTop_toTopOf="@+id/deliveryPriceText">
        <TextView
            android:textColor="@color/basics500"
            android:gravity="right"
            android:id="@+id/deliveryPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/DescriptionLabel"/>
        <ImageView
            android:id="@+id/deliveryPriceInfo"
            android:visibility="gone"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/ic_info_grey_filled"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2.25dp"/>
    </LinearLayout>
    <crc64fac7521b55e1fcf3.CrossingTextView
        android:id="@+id/oldDeliveryPrice"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="7dp"
        app:cellTextColor="@color/basics500"
        app:cellTextSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/deliveryPriceText"
        app:layout_constraintRight_toLeftOf="@+id/deliveryPriceContainer"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/basics700"
        android:id="@+id/totalPriceText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/loyalty_snack"
        app:layout_constraintEnd_toStartOf="@+id/totalPrice"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/loyalty_snack"
        app:layout_goneMarginBottom="9dp"
        style="@style/CartLabelInfo"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/basics700"
        android:gravity="right"
        android:id="@+id/totalPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/totalPriceText"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintTop_toTopOf="@+id/totalPriceText"
        style="@style/CartLabelInfo"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/loyalty_snack"
        android:background="@drawable/bg_snack_green"
        android:padding="12dp"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toTopOf="@+id/delayed_cashback_snack"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/totalPriceText">
        <ImageView
            android:layout_gravity="top"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_info_green"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/basics700"
            android:id="@+id/loyalty_snack_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3sp"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/delayed_cashback_snack"
        android:background="@drawable/bg_snack_gray200"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/loyalty_snack">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:src="@drawable/ic_delayed_bonuses_info"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/basics700"
            android:id="@+id/delayed_cashback_snack_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3sp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
