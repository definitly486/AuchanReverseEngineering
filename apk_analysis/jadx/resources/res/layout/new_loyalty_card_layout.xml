<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@mipmap/img_loyalty_card_color_shadow"
        android:layout_width="0dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/shadow_bottom_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:background="@drawable/loyalty_card_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@mipmap/img_loyalty"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/points_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toStartOf="@+id/express_points_group"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/loyalty_card_points_value_font_size"
                    android:textStyle="bold"
                    android:textColor="@color/basics100"
                    android:id="@+id/points_value_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/loyalty_card_points_title_font_size"
                    android:textColor="@color/primary100"
                    android:id="@+id/points_title_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/express_points_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toStartOf="@+id/marks_group"
                app:layout_constraintStart_toEndOf="@+id/points_group"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/loyalty_card_points_value_font_size"
                    android:textStyle="bold"
                    android:textColor="@color/basics100"
                    android:id="@+id/express_points_value_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/loyalty_card_points_title_font_size"
                    android:textColor="@color/primary100"
                    android:id="@+id/express_points_title_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/marks_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toStartOf="@+id/loyalty_qr_button"
                app:layout_constraintStart_toEndOf="@+id/express_points_group"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/loyalty_card_points_value_font_size"
                    android:textStyle="bold"
                    android:textColor="@color/basics100"
                    android:id="@+id/marks_value_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/loyalty_card_points_title_font_size"
                    android:textColor="@color/primary100"
                    android:id="@+id/marks_title_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/loyalty_qr_button"
                android:layout_width="@dimen/loyalty_card_qr_button_size"
                android:layout_height="@dimen/loyalty_card_qr_button_size"
                android:src="@mipmap/ic_loyalty_qr"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="loyalty_qr_button,points_group,express_points_group,marks_group"/>
            <ImageView
                android:id="@+id/loyalty_warning"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/ic_loyalty_warning"
                android:scaleType="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/barrier"
                app:layout_constraintVertical_bias="0"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cornflower_lilac"
                android:id="@+id/loyalty_warning_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                app:layout_constraintBottom_toBottomOf="@+id/loyalty_warning"
                app:layout_constraintStart_toEndOf="@+id/loyalty_warning"
                app:layout_constraintTop_toTopOf="@+id/loyalty_warning"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/more_button"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="13dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/loyalty_warning">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/basics100"
                    android:id="@+id/more_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_chevron_right_white"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/help_button"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_help_button_16"
                android:scaleType="center"
                android:tint="@color/basics100"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <View
        android:id="@+id/shadow_bottom_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card"/>
    <crc64fac7521b55e1fcf3.LoyaltyCardHintView
        android:id="@+id/loyalty_card_hint_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/card"/>
</androidx.constraintlayout.widget.ConstraintLayout>
