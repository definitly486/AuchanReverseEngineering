<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="20dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:paddingTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/checkbox"
            android:background="@android:color/transparent"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="24dp"
            android:checked="false"
            android:button="@drawable/toggle_selector_green"
            android:layout_marginStart="17dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/checkbox"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:id="@+id/logo_container"
                android:background="@drawable/bg_rounded_border_8_gray400"
                android:padding="4dp"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:backgroundTint="@color/gray200"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/item_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"/>
            </FrameLayout>
            <TextView
                android:textColor="@color/basics700"
                android:ellipsize="end"
                android:id="@+id/item_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:layout_marginStart="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/logo_container"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/modifications_list"
                android:scrollbars="none"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/logo_container"
                app:layout_constraintTop_toBottomOf="@+id/item_title"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/basics700"
                android:id="@+id/item_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toEndOf="@+id/logo_container"
                app:layout_constraintTop_toBottomOf="@+id/modifications_list"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/price_per_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/item_price"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/item_price"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/inc_dec_layout"
            android:background="@color/gray200"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/gray200"
            app:cardCornerRadius="10dp"
            app:layout_constraintStart_toStartOf="@+id/top_container"
            app:layout_constraintTop_toBottomOf="@+id/top_container">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp">
                <ImageView
                    android:id="@+id/decrease_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/minus_button_selector"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/basics700"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/item_count"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:singleLine="true"/>
                <ImageView
                    android:id="@+id/increase_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/plus_button_selector"
                    android:scaleType="fitCenter"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/textSecondary"
            android:id="@+id/stock_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/inc_dec_layout"
            app:layout_constraintEnd_toStartOf="@+id/favorite_button"
            app:layout_constraintStart_toEndOf="@+id/inc_dec_layout"
            app:layout_constraintTop_toTopOf="@+id/inc_dec_layout"/>
        <ImageView
            android:id="@+id/favorite_button"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="22dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <View
            android:id="@+id/separator"
            android:background="@color/catskill_white"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/inc_dec_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
