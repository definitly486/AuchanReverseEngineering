<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="36dp"
        app:cardBackgroundColor="@color/back_to_school_green"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/puller"
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:layout_marginTop="40dp"
            android:src="@drawable/bottom_sheet_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:id="@+id/closeButtonBackground"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="59dp"
            android:layout_marginEnd="11dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/closeButton"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/ic_close"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <ImageView
            android:background="@drawable/popup_new_year_game_popup_snow"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="57dp"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <crc64fac7521b55e1fcf3.SkottieAnimationView
            android:id="@+id/animation"
            android:layout_width="match_parent"
            android:layout_height="310dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:skottie_autoPlay="true"
            app:skottie_fileName="lf30_c6fxpq4x.json"
            app:skottie_loop="true"/>
        <TextView
            android:textAppearance="@style/NewYearPopupLabel"
            android:textSize="20sp"
            android:gravity="center"
            android:id="@+id/popupText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-26dp"
            android:layout_marginBottom="28dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:lineHeight="24sp"
            app:layout_constraintBottom_toTopOf="@+id/playButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textAppearance="@style/TextAppearance.BoldButtonText"
            android:textSize="24sp"
            android:textColor="@color/basics100"
            android:gravity="center"
            android:id="@+id/playButton"
            android:background="@drawable/new_year_popup_button_big"
            android:paddingBottom="10dp"
            android:layout_width="202dp"
            android:layout_height="60dp"
            android:layout_marginTop="58dp"
            android:text="Играть"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/animation"/>
        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/dontShowToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="65dp"
            android:layout_marginEnd="65dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/playButton"
            style="@style/CheckboxGameStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
