<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/messageBubbleContainer"
        android:background="@drawable/bg_support_chat_message_bubble"
        android:padding="2dp"
        android:clipChildren="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.8">
        <androidx.cardview.widget.CardView
            android:id="@+id/messageImageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">
            <TextView
                android:autoLink="phone|web"
                android:linksClickable="true"
                android:id="@+id/messageImageText"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:textIsSelectable="true"
                android:layout_marginHorizontal="12dp"/>
            <ImageView
                android:id="@+id/messageImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Regular"
            android:textColor="@color/gray900"
            android:textColorLink="#0280fb"
            android:autoLink="phone|web"
            android:linksClickable="true"
            android:id="@+id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"
            android:text="This is a message, it can be very long and it will wrap around the bubble         \1011111111111111111111111111111111111111111111111"
            android:textIsSelectable="true"/>
        <View
            android:background="@android:color/transparent"
            android:layout_width="30dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="12dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/errorView"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_chat_warning"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/messageBubbleContainer"
        app:layout_constraintEnd_toStartOf="@+id/messageBubbleContainer"
        app:layout_constraintTop_toTopOf="@+id/messageBubbleContainer"/>
    <TextView
        android:textAppearance="@style/TextAppearance.SubtextRegular"
        android:textSize="12sp"
        android:textColor="@color/chat_message_timestamp"
        android:id="@+id/timestamp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/messageBubbleContainer"
        app:layout_constraintEnd_toEndOf="@+id/messageBubbleContainer"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/timestampBackgroundContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="6dp"
        app:cardBackgroundColor="@color/chat_timestamp_on_image_background"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/messageBubbleContainer"
        app:layout_constraintEnd_toEndOf="@+id/messageBubbleContainer">
        <TextView
            android:textAppearance="@style/TextAppearance.SubtextRegular"
            android:textSize="12sp"
            android:textColor="@color/basics100"
            android:layout_gravity="center"
            android:id="@+id/timestampAtBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="2dp"/>
    </androidx.cardview.widget.CardView>
</merge>
