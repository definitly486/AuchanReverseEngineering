<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetStart="0dp"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/back_button"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/ToolbarImageButton.Back"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.Title"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/toolbar_title"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginLeft="40dp"
                    android:layout_marginRight="40dp"
                    android:maxLines="2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/right_button"
                    android:visibility="gone"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/ToolbarImageButton"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.Toolbar>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/defaultLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/app_bar"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stateListAnimator="@null">
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/basics700"
                    android:ellipsize="end"
                    android:id="@+id/store_details_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    app:layout_scrollFlags="exitUntilCollapsed|scroll"/>
            </com.google.android.material.appbar.AppBarLayout>
            <androidx.core.widget.NestedScrollView
                android:id="@+id/order_detail_scrollView"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:background="@color/gray400"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="25dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/textSecondary"
                            android:id="@+id/store_details_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:lineSpacingMultiplier="1.25"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/light_main"
                            android:id="@+id/store_details_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingMultiplier="1.25"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/light_main"
                            android:id="@+id/store_details_phone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingMultiplier="1.25"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/store_detail_distanse_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/store_detail_distance_icon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_shops_route"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/gray600"
                                android:id="@+id/store_detail_distance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="6dp"
                                android:layout_marginRight="12dp"/>
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/store_detail_parking_icon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_shops_parking"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/gray600"
                                android:id="@+id/store_detail_parking"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="6dp"/>
                        </LinearLayout>
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">
                            <p000auchan.controls.CustomMapView
                                android:id="@+id/store_details_mapview"
                                android:layout_width="match_parent"
                                android:layout_height="200dp"/>
                        </androidx.cardview.widget.CardView>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/build_route_button"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:textAllCaps="false"
                            style="@style/DefaultGreenMaterialRoundButtonM"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp">
                            <ImageView
                                android:id="@+id/stores_item_schedule_icon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginLeft="2dp"
                                android:layout_marginTop="2dp"
                                android:src="@drawable/ic_shops_clock"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/gray600"
                                android:ellipsize="end"
                                android:id="@+id/stores_item_schedule"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="0dp"
                                android:maxLines="4"
                                android:lineSpacingMultiplier="1.25"
                                android:layout_marginStart="6dp"
                                android:layout_marginEnd="0dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/stores_item_schedule_icon"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/working_status_layout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="0dp"
                                android:layout_marginStart="25dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/stores_item_schedule">
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/green_counter"
                                    android:id="@+id/working_status_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:lineSpacingMultiplier="1.25"
                                    android:layout_marginStart="0dp"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/gray600"
                                    android:id="@+id/working_status_dot"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="•"
                                    android:lineSpacingMultiplier="1.25"
                                    android:layout_marginStart="6dp"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/light_main"
                                    android:id="@+id/working_status_description"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:lineSpacingMultiplier="1.25"
                                    android:layout_marginStart="6dp"/>
                            </LinearLayout>
                            <p000auchan.TempWorkInformerView
                                android:id="@+id/temp_work_informer"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/working_status_layout"/>
                            <p000auchan.TempWorkTimeView
                                android:id="@+id/tempWorkTimeLayout"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:layout_marginRight="58dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="@+id/working_status_layout"
                                app:layout_constraintTop_toBottomOf="@+id/temp_work_informer"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>
                    <View
                        android:id="@+id/store_details_schedule_separator"
                        android:background="@color/separatorColor"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"/>
                    <crc64fac7521b55e1fcf3.NavigationCellViewStores
                        android:id="@+id/store_details_public_transport_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cellIcon="@drawable/ic_shops_transport"
                        app:cellText="@string/public_transport"
                        app:separatorMarginLeft="0dp"
                        app:separatorMarginRight="0dp"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginHorizontal="20dp">
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/light_main"
                            android:id="@+id/store_details_description_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/store_details_description_all_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="16sp"
                                android:textColor="@color/green_counter"
                                android:layout_gravity="center"
                                android:id="@+id/store_details_description_all_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="2dp"/>
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/navigation_arrow"
                                android:tint="@color/green_counter"/>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/light_main"
                        android:ellipsize="end"
                        android:id="@+id/store_details_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:maxLines="5"
                        android:lineSpacingMultiplier="1.25"
                        android:layout_marginHorizontal="20dp"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginHorizontal="20dp">
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/light_main"
                            android:id="@+id/store_details_services_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/store_details_all_services"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="16sp"
                                android:textColor="@color/green_counter"
                                android:layout_gravity="center"
                                android:id="@+id/store_details_all_services_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="2dp"/>
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/navigation_arrow"
                                android:tint="@color/green_counter"/>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="horizontal"
                        android:id="@+id/store_details_services_list"
                        android:paddingTop="16dp"
                        android:paddingBottom="24dp"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="7dp"
                        android:paddingEnd="20dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </LinearLayout>
    <include
        android:id="@+id/errorLayout"
        android:visibility="gone"
        layout="@layout/error"/>
    <include
        android:id="@+id/progressLayout"
        android:visibility="gone"
        layout="@layout/progress"/>
</FrameLayout>
