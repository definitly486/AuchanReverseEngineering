<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="16dp">
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/select_file_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Прикрепить файлы"
        android:textAllCaps="false"
        style="@style/OutlineRedButton"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Размер одного файла не более 1 Мб (jpeg, jpg, png)"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/files_interaction_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <HorizontalScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/media_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:divider="@android:color/transparent"
                android:dividerPadding="10dp"/>
        </HorizontalScrollView>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/remove_files_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_trash_red"/>
            <TextView
                android:textColor="@color/red_ribbon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Удалить все файлы"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
