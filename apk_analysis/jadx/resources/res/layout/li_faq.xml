<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="25px"
    android:minHeight="25px">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/faqCell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="spread">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/basics600"
            android:id="@+id/faqItemQuestionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="13dp"
            android:layout_marginRight="47dp"
            android:text="Test question?"
            android:maxLines="100"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/InfoItemLabel"/>
        <ImageView
            android:id="@+id/chevronImageDown"
            android:layout_width="18dp"
            android:layout_height="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="22dp"
            android:src="@drawable/ic_chevron_down"
            app:layout_constraintBottom_toBottomOf="@+id/faqItemQuestionLabel"
            app:layout_constraintLeft_toRightOf="@+id/faqItemQuestionLabel"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/faqItemQuestionLabel"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/basics500"
            android:id="@+id/faqItemAnswerLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="7dp"
            android:text="Test answer Test answer Test answer Test answer Test answer Test answer Test answer Test answer Test answer Test answer Test answer "
            android:maxLines="100"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/faqItemQuestionLabel"
            style="@style/DescriptionLabel"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/separator"
        android:background="@color/separatorColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <View
        android:id="@+id/lastSeparator"
        android:background="@color/separatorColor"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
