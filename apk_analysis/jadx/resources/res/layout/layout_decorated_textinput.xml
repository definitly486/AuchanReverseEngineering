<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/product_rate_root"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:textColor="@color/black"
        android:id="@+id/commentEditText"
        android:background="@drawable/round_top_corners_8_basics150"
        android:paddingLeft="10dp"
        android:paddingTop="26dp"
        android:paddingRight="40dp"
        android:paddingBottom="7dp"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="8"
        android:inputType="textMultiLine"
        android:imeOptions="actionDone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/danger200"
        android:id="@+id/upperHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:text="type here"
        android:fontFamily="sans-serif"
        app:layout_constraintStart_toStartOf="@+id/commentEditText"
        app:layout_constraintTop_toTopOf="@+id/commentEditText"/>
    <View
        android:id="@+id/underline"
        android:background="@color/green_counter"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="@+id/commentEditText"
        app:layout_constraintStart_toStartOf="@+id/commentEditText"
        app:layout_constraintTop_toBottomOf="@+id/commentEditText"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/danger200"
        android:id="@+id/bottomLeftText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="4dp"
        android:text="ot 200 do 2000"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/commentEditText"
        app:layout_constraintTop_toBottomOf="@+id/underline"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/danger200"
        android:id="@+id/bottomRightText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="10dp"
        android:text="150/200"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/commentEditText"
        app:layout_constraintTop_toBottomOf="@+id/underline"/>
</androidx.constraintlayout.widget.ConstraintLayout>
