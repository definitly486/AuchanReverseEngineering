<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bannerCell"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/backgroundSquare"
        android:clipChildren="true"
        android:layout_width="0dp"
        android:layout_height="114dp"
        android:layout_marginTop="3dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/title_container"
                android:background="@color/pers_offer_header_cashback"
                android:paddingRight="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="12dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/basics700"
                    android:id="@+id/title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:fontFamily="sans-serif"
                    android:textFontWeight="500"/>
                <ImageView
                    android:id="@+id/title_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="4dp"
                    android:src="@drawable/ic_bonuses"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/title_tail"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginLeft="-1dp"
                android:src="@drawable/img_offer_header_tail_green"
                app:layout_constraintBottom_toBottomOf="@+id/title_container"
                app:layout_constraintStart_toEndOf="@+id/title_container"
                app:layout_constraintTop_toTopOf="@+id/title_container"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/textSecondary"
                android:ellipsize="end"
                android:id="@+id/description_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="0dp"
                android:maxLines="3"
                android:textFontWeight="400"
                app:layout_constraintLeft_toLeftOf="@+id/title_container"
                app:layout_constraintRight_toLeftOf="@+id/image_sublayer"
                app:layout_constraintTop_toBottomOf="@+id/title_container"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/textSecondary"
                android:id="@+id/offerTimeTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                android:layout_marginBottom="12dp"
                android:text="time"
                android:textFontWeight="400"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="@+id/title_container"
                app:layout_constraintRight_toLeftOf="@+id/bannerImageView"/>
            <ImageView
                android:id="@+id/image_sublayer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/img_offer_image_sublayer"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="124:114"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/bannerImageView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <FrameLayout
        android:id="@+id/indicator"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:translationX="-4dp"
        android:translationY="-4dp"
        app:layout_constraintLeft_toLeftOf="@+id/backgroundSquare"
        app:layout_constraintTop_toTopOf="@+id/backgroundSquare">
        <View
            android:id="@+id/indicator_background"
            android:background="@drawable/rounded_corners_5_white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:background="@drawable/rounded_corners_4_red"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginLeft="1dp"
            android:layout_marginTop="1dp"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="12sp"
        android:id="@+id/acceptButton"
        android:layout_width="105dp"
        android:layout_height="22dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:text="Разместить отзыв 3"
        android:textAllCaps="false"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="@+id/backgroundSquare"
        app:layout_constraintRight_toRightOf="@+id/backgroundSquare"
        style="@style/DefaultGreenButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
