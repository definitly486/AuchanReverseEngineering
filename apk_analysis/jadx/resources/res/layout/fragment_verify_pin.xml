<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/defaultLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:id="@+id/header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.HeaderAuth"/>
            <p000auchan.HighlightedTextView
                android:textSize="14sp"
                android:textColor="@color/shark"
                android:id="@+id/message_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:textAppearanceHighlighted="@style/TextAppearance.LoginMessageHighlighted"/>
            <p000auchan.PinEntryView
                android:layout_gravity="center_horizontal"
                android:id="@+id/pin_input"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/light_secondary"
                android:gravity="center"
                android:id="@+id/sms_countdown_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="12sp"
                android:layout_gravity="center"
                android:id="@+id/get_pin_button"
                android:visibility="gone"
                android:layout_width="193dp"
                android:layout_height="36dp"
                android:layout_marginTop="24dp"
                android:textAllCaps="false"
                android:backgroundTint="@color/green_material_button_selector"
                style="@style/DefaultMaterialButton"/>
            <TextView
                android:textColor="@color/green_counter"
                android:gravity="center"
                android:id="@+id/didnt_receive_sms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
        <include
            android:id="@+id/progressLayout"
            android:visibility="gone"
            layout="@layout/progress"/>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
