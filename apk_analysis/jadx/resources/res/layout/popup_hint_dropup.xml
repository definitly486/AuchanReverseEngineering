<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="bottom|left"
        android:id="@+id/triangle_view"
        android:background="@drawable/bg_up_triangle_gray900"
        android:layout_width="21dp"
        android:layout_height="15dp"
        android:layout_marginLeft="0dp"
        android:rotation="180"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_text_container"
        android:background="@drawable/bg_rounded_8_gray900"
        android:paddingLeft="12dp"
        android:paddingTop="10dp"
        android:paddingRight="12dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0dp"
        android:layout_marginBottom="7dp">
        <TextView
            android:textAppearance="@style/TextAppearance.SubtextMedium"
            android:textColor="@color/basics100"
            android:id="@+id/content_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
