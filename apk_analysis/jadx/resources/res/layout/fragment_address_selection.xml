<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@color/basics100"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentInsetStart="0dp"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/back_button"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="14dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/ToolbarImageButton.Back"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.Title"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/toolbar_title"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:maxLines="1"
                    android:lines="1"
                    android:layout_marginEnd="44dp"
                    app:layout_constraintBottom_toBottomOf="@+id/back_button"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/back_button"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.Toolbar>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">
            <androidx.cardview.widget.CardView
                android:id="@+id/delivery_type_selector"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/gray200"
                android:layout_marginHorizontal="20dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:layout_marginHorizontal="4dp">
                    <FrameLayout
                        android:id="@+id/delivery_button_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.google.android.material.button.MaterialButton
                            android:textAppearance="@style/TextAppearance.Body1Medium"
                            android:textSize="16sp"
                            android:textColor="@color/light_main"
                            android:id="@+id/delivery_button_active"
                            android:padding="0dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:lines="1"
                            android:textAllCaps="false"
                            android:elevation="18dp"
                            android:stateListAnimator="@null"
                            android:backgroundTint="@color/basics100"
                            app:cornerRadius="8dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:textAppearance="@style/TextAppearance.Body1Medium"
                            android:textSize="16sp"
                            android:textColor="@color/light_secondary"
                            android:id="@+id/delivery_button_inactive"
                            android:padding="0dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:lines="1"
                            android:textAllCaps="false"
                            app:rippleColor="@android:color/transparent"
                            app:strokeWidth="0dp"
                            style="?attr/materialButtonOutlinedStyle"/>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_gravity="center_vertical"
                        android:layout_width="1dp"
                        android:layout_height="16dp">
                        <View
                            android:id="@+id/deliveryPickupSeparator"
                            android:background="@color/gray400"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/pickup_button_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.google.android.material.button.MaterialButton
                            android:textAppearance="@style/TextAppearance.Body1Medium"
                            android:textSize="16sp"
                            android:textColor="@color/light_main"
                            android:id="@+id/pickup_button_active"
                            android:padding="0dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:lines="1"
                            android:textAllCaps="false"
                            android:elevation="18dp"
                            android:stateListAnimator="@null"
                            android:backgroundTint="@color/basics100"
                            app:cornerRadius="8dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:textAppearance="@style/TextAppearance.Body1Medium"
                            android:textSize="16sp"
                            android:textColor="@color/light_secondary"
                            android:id="@+id/pickup_button_inactive"
                            android:padding="0dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:lines="1"
                            android:textAllCaps="false"
                            app:rippleColor="@android:color/transparent"
                            app:strokeWidth="0dp"
                            style="?attr/materialButtonOutlinedStyle"/>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_gravity="center_vertical"
                        android:layout_width="1dp"
                        android:layout_height="16dp">
                        <View
                            android:id="@+id/PickupCarPickupSeparator"
                            android:background="@color/gray400"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/car_pickup_button_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.google.android.material.button.MaterialButton
                            android:textAppearance="@style/TextAppearance.Body1Medium"
                            android:textSize="16sp"
                            android:textColor="@color/light_main"
                            android:id="@+id/car_pickup_button_active"
                            android:padding="0dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:lines="1"
                            android:textAllCaps="false"
                            android:elevation="18dp"
                            android:stateListAnimator="@null"
                            android:backgroundTint="@color/basics100"
                            app:cornerRadius="8dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:textAppearance="@style/TextAppearance.Body1Medium"
                            android:textSize="16sp"
                            android:textColor="@color/light_secondary"
                            android:id="@+id/car_pickup_button_inactive"
                            android:padding="0dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:lines="1"
                            android:textAllCaps="false"
                            app:rippleColor="@android:color/transparent"
                            app:strokeWidth="0dp"
                            style="?attr/materialButtonOutlinedStyle"/>
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/defaultLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="20dp"
                app:layout_constraintBottom_toTopOf="@+id/saveButtonBackground"
                app:layout_constraintTop_toBottomOf="@+id/delivery_type_selector">
                <FrameLayout
                    android:id="@+id/details_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:id="@+id/empty"
                        android:paddingTop="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/addressList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/pickupStoreList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/carPickupStoreList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/address_progress_container"
                    android:background="@android:color/transparent"
                    android:padding="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <FrameLayout
                        android:id="@+id/address_progress"
                        android:background="@drawable/round_corners_12"
                        android:padding="4dp"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/white">
                        <crc64fac7521b55e1fcf3.SkottieAnimationView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:buttonTint="@color/primary400"
                            app:skottie_autoPlay="true"
                            app:skottie_fileName="lottie-loader.json"
                            app:skottie_loop="true"/>
                    </FrameLayout>
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/saveButtonBackground"
                android:background="@color/basics100"
                android:paddingBottom="34dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">
                <View
                    android:id="@+id/bottomSeparator"
                    android:background="@color/gray400"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="15dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:textAllCaps="false"
                    android:layout_marginHorizontal="20dp"
                    app:cornerRadius="8dp"
                    style="@style/GreenMaterialRoundButtonDisabledGreen"/>
                <com.google.android.material.button.MaterialButton
                    android:textColor="@color/light_main"
                    android:id="@+id/addButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    android:layout_marginHorizontal="20dp"
                    app:cornerRadius="8dp"
                    style="@style/LightGrayMaterialRoundButton"/>
            </LinearLayout>
            <include
                android:id="@+id/global_progress"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/progress"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
