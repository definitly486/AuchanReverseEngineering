<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.scanflow.datacapture.sfbarcode.SFCameraView
        android:id="@+id/cameraView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/noCameraLayout"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/black">
        <ImageView
            android:id="@+id/noCameraCloseButton"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:rotation="180"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/noCameraHeaderTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/noCameraHeaderTextView"
            app:srcCompat="@drawable/ic_chevron_right_white"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/noCameraHeaderTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:maxLines="1"
            android:textAlignment="center"
            android:layout_marginHorizontal="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="wrap"/>
        <ImageView
            android:id="@+id/noCameraHeaderChevron"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginBottom="3dp"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/noCameraHeaderTextView"
            app:layout_constraintStart_toEndOf="@+id/noCameraHeaderTextView"
            app:srcCompat="@drawable/ic_chevron_down"
            app:tint="@color/white"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/noCameraTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="300dp"
            android:textAlignment="center"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/noCameraSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAlignment="center"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/noCameraTitle"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#007aff"
            android:id="@+id/noCameraSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:textAlignment="center"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/noCameraSubtitle"/>
        <Button
            android:textSize="12sp"
            android:layout_gravity="center"
            android:id="@+id/noCameraEnterManuallyButton"
            android:layout_width="153dp"
            android:layout_height="40dp"
            android:layout_marginBottom="40dp"
            android:textAllCaps="false"
            app:layout_constraintBottom_toTopOf="@+id/noCameraBottomInfoView"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            style="@style/WhiteButton"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/noCameraBottomInfoView"
            android:layout_width="match_parent"
            android:layout_height="154dp"
            android:layout_marginBottom="-20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <crc64fac7521b55e1fcf3.SnackView
                android:id="@+id/noCameraWarningView"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="28dp"
                android:layout_marginRight="20dp"
                app:cellBackground="@drawable/bg_snack_primary01"
                app:cellIcon="@drawable/ic_snackbar_warning"
                app:cellTextColor="@color/monza"
                app:layout_constraintBottom_toTopOf="@+id/totalItemsPriceText"
                app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                app:layout_constraintStart_toStartOf="@+id/start_guideline"
                app:layout_constraintTop_toBottomOf="@+id/totalHeaderText"/>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/cameraLayout"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <ImageView
                android:id="@+id/closeButton"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:rotation="180"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/headerTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/headerTextView"
                app:srcCompat="@drawable/ic_chevron_right_white"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/headerTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="center"
                android:layout_marginHorizontal="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="wrap"/>
            <ImageView
                android:id="@+id/headerChevron"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginBottom="3dp"
                android:layout_marginStart="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/headerTextView"
                app:layout_constraintStart_toEndOf="@+id/headerTextView"
                app:srcCompat="@drawable/ic_chevron_down"
                app:tint="@color/white"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/focusOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/subHeaderTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="35dp"
                app:layout_constraintBottom_toTopOf="@+id/focusImage"
                app:layout_constraintEnd_toEndOf="@+id/focusImage"
                app:layout_constraintStart_toStartOf="@+id/focusImage"/>
            <View
                android:id="@+id/focusImage"
                android:layout_width="0dp"
                android:layout_height="224dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/actionLayout"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                app:layout_constraintBottom_toTopOf="@+id/bottom_guideline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/focusImage">
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/snackLayout"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/snackIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"/>
                </LinearLayout>
            </FrameLayout>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/bottom_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="1"/>
            <ImageView
                android:id="@+id/flash_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="16dp"
                android:layout_marginBottom="8dp"
                android:src="@drawable/flash_on"
                app:layout_constraintBottom_toTopOf="@+id/bottomInfoView"
                app:layout_constraintLeft_toLeftOf="parent"/>
            <Button
                android:textSize="12sp"
                android:layout_gravity="center"
                android:id="@+id/enterManuallyButton"
                android:layout_width="153dp"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:textAllCaps="false"
                app:layout_constraintBottom_toTopOf="@+id/bottomInfoView"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                style="@style/WhiteButton"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/bottomInfoView"
                android:layout_width="match_parent"
                android:layout_height="154dp"
                android:layout_marginBottom="-20dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:layout_constraintBottom_toBottomOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/infoTextView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginRight="20dp"/>
                <crc64fac7521b55e1fcf3.SnackView
                    android:id="@+id/warningView"
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginRight="20dp"
                    app:cellBackground="@drawable/bg_snack_primary01"
                    app:cellIcon="@drawable/ic_snackbar_warning"
                    app:cellTextColor="@color/monza"
                    app:layout_constraintBottom_toTopOf="@+id/totalItemsPriceText"
                    app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                    app:layout_constraintStart_toStartOf="@+id/start_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/totalHeaderText"/>
            </androidx.cardview.widget.CardView>
            <FrameLayout
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                app:layout_constraintBottom_toBottomOf="@+id/bottomInfoView"
                app:layout_constraintLeft_toLeftOf="@+id/bottomInfoView"
                app:layout_constraintRight_toRightOf="@+id/bottomInfoView"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:id="@+id/progressLayout"
            android:visibility="gone"
            layout="@layout/progress"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
