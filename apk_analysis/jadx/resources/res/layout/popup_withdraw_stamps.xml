<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/basics100"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shapeAppearance="@style/TopCornersShape">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/default_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="20dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/puller"
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/bottom_sheet_line"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/basics700"
            android:gravity="left"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.2"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/basics700"
            android:gravity="left"
            android:id="@+id/collectedStamps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.2"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/basics700"
            android:gravity="left"
            android:id="@+id/actionDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.2"
            android:fontFamily="sans-serif"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/products_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="true"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/continue_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            app:cornerRadius="8dp"
            style="@style/DefaultGreenMaterialRoundButton"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dont_apply_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            app:cornerRadius="8dp"
            style="@style/DefaultGrayMaterialRoundButton"/>
    </LinearLayout>
    <include
        android:id="@+id/errorLayout"
        android:visibility="gone"
        layout="@layout/comarch_error_view"/>
</com.google.android.material.card.MaterialCardView>
