<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shapeAppearance="@style/TopCornersShape">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/rootScrollView"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/start_guideline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_begin="20dp"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/end_guideline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_end="20dp"/>
                <ImageView
                    android:id="@+id/bottomSheetHandle"
                    android:layout_width="36dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/bottom_sheet_line"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/light_main"
                    android:gravity="center"
                    android:id="@+id/screenTitleTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif"
                    android:textAlignment="center"
                    android:lineHeight="24dp"
                    android:textFontWeight="700"
                    app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                    app:layout_constraintStart_toStartOf="@+id/start_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/bottomSheetHandle"/>
                <ImageView
                    android:id="@+id/closeButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ic_close_light"
                    app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/bottomSheetHandle"/>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/productCardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/screenTitleTextView">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/productImage"
                            android:background="@drawable/bg_rounded_border_8_gray200"
                            android:padding="1dp"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:layout_marginStart="12dp"
                            android:clipToOutline="true"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/light_main"
                            android:id="@+id/productName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:text="productName"
                            android:fontFamily="sans-serif"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="12dp"
                            android:lineHeight="24dp"
                            android:textFontWeight="500"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/productImage"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
                <p000auchan.RatingView
                    android:id="@+id/ratingView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                    app:layout_constraintStart_toStartOf="@+id/start_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/productCardView"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/gray600"
                    android:gravity="center"
                    android:id="@+id/rateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:lineHeight="14dp"
                    android:textFontWeight="400"
                    app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                    app:layout_constraintStart_toStartOf="@+id/start_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/ratingView"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/light_main"
                    android:id="@+id/triggerWordsTitleTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="sans-serif"
                    android:lineHeight="24dp"
                    android:textFontWeight="700"
                    app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                    app:layout_constraintStart_toStartOf="@+id/start_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/rateText"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/triggerWordsRecycler"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                    app:layout_constraintStart_toStartOf="@+id/start_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/triggerWordsTitleTextView"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/additionalFieldsContainer"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                    app:layout_constraintStart_toStartOf="@+id/start_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/triggerWordsRecycler">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/manufacturerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/AddressEditingLayout">
                        <crc64fac7521b55e1fcf3.OutlinedErrorEditText
                            android:textColor="@color/light_main"
                            android:id="@+id/manufacturerEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="0"
                            android:inputType="text"
                            android:imeOptions="actionDone"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Body2Regular"
                        android:textColor="@color/text_secondary"
                        android:id="@+id/manufacturerHelper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/productionDateLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        style="@style/AddressEditingLayout">
                        <crc64fac7521b55e1fcf3.OutlinedErrorEditText
                            android:textSize="16sp"
                            android:textColor="@color/light_main"
                            android:id="@+id/productionDateEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="date"
                            android:letterSpacing="0"
                            android:textFontWeight="500"
                            app:emojiCompatEnabled="false"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Body2Regular"
                        android:textColor="@color/text_secondary"
                        android:id="@+id/productionHelper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/commentLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                    app:layout_constraintStart_toStartOf="@+id/start_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/additionalFieldsContainer"
                    style="@style/AddressEditingLayout">
                    <crc64fac7521b55e1fcf3.OutlinedErrorEditText
                        android:textColor="@color/light_main"
                        android:id="@+id/commentEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:imeOptions="actionDone"/>
                </com.google.android.material.textfield.TextInputLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/commentValidationRow"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                    app:layout_constraintStart_toStartOf="@+id/start_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/commentLayout">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/primary_TextError"
                        android:id="@+id/commentErrorText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:layout_marginEnd="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/commentErrorCounter"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/primary_TextError"
                        android:id="@+id/commentErrorCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/commentSizeWarning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                    app:layout_constraintStart_toStartOf="@+id/start_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/commentValidationRow">
                    <ProgressBar
                        android:id="@+id/commentSizeWarningProgress"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:max="100"
                        android:progress="25"
                        android:secondaryProgress="100"
                        android:indeterminate="false"
                        android:progressDrawable="@drawable/round_progress_bar_gray"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="?android:attr/progressBarStyleHorizontal"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/textSecondary"
                        android:id="@+id/commentSizeWarningText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="4dp"
                        android:lineHeight="14dp"
                        android:textFontWeight="400"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/commentSizeWarningProgress"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/addPhotoButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintLeft_toLeftOf="@+id/start_guideline"
                    app:layout_constraintRight_toRightOf="@+id/end_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/commentSizeWarning">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_clip_attach_green"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/primary02_TextActive"
                        android:gravity="center_vertical"
                        android:id="@+id/addPhotoButtonText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:fontFamily="sans-serif"
                        android:lineHeight="24dp"
                        android:textFontWeight="400"/>
                </LinearLayout>
                <TextView
                    android:textAppearance="@style/TextAppearance.SubtextRegular"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/imagesWarning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                    app:layout_constraintStart_toStartOf="@+id/start_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/addPhotoButton"/>
                <p000auchan.PhotoSelectionView
                    android:id="@+id/photoSelectionView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/imagesWarning"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/primary_TextError"
                    android:id="@+id/photoUploadErrorText"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:lineHeight="14dp"
                    android:textFontWeight="400"
                    app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                    app:layout_constraintStart_toStartOf="@+id/start_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/photoSelectionView"/>
                <crc64fac7521b55e1fcf3.SnackView
                    android:id="@+id/chatBotWarning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cellBackground="@drawable/bg_snack_gray200"
                    app:cellIcon="@drawable/ic_info_grey_filled"
                    app:cellTextColor="@color/text_secondary"
                    app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                    app:layout_constraintStart_toStartOf="@+id/start_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/photoUploadErrorText"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/sendReviewButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:textAllCaps="false"
                    app:layout_constraintLeft_toLeftOf="@+id/start_guideline"
                    app:layout_constraintRight_toRightOf="@+id/end_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/chatBotWarning"
                    style="@style/DefaultGreenButton"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:gravity="center"
                    android:id="@+id/rulesTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif"
                    android:textAlignment="center"
                    android:lineHeight="14dp"
                    android:textFontWeight="400"
                    app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                    app:layout_constraintStart_toStartOf="@+id/start_guideline"
                    app:layout_constraintTop_toBottomOf="@+id/sendReviewButton"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <include
            android:id="@+id/progressLayout"
            android:visibility="gone"
            layout="@layout/progress"/>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
