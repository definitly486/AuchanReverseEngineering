<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="6dp"
    android:paddingBottom="30dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <ImageView
        android:id="@+id/bottomSheetLine"
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:src="@drawable/bottom_sheet_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/light_main"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="2"
        app:layout_constraintEnd_toStartOf="@+id/closeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomSheetLine"
        style="@style/TextAppearance.Subhead2Bold"/>
    <ImageView
        android:id="@+id/closeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_close_dark"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Subhead1Bold"
        android:textColor="@color/light_main"
        android:id="@+id/priceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp"
        app:layout_constraintBottom_toTopOf="@+id/feedbackButton"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.SubtextRegular"
        android:textColor="@color/text_secondary"
        android:id="@+id/old_price_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/priceText"
        app:layout_constraintStart_toEndOf="@+id/priceText"/>
    <View
        android:id="@+id/old_price_crossing_line"
        android:background="@color/torch_red"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:rotation="-18"
        app:layout_constraintBottom_toBottomOf="@+id/old_price_label"
        app:layout_constraintEnd_toEndOf="@+id/old_price_label"
        app:layout_constraintStart_toStartOf="@+id/old_price_label"
        app:layout_constraintTop_toTopOf="@+id/old_price_label"/>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/text_secondary"
        android:id="@+id/unitTypeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/priceText"/>
    <com.google.android.material.button.MaterialButton
        android:textColor="@color/textSecondary"
        android:gravity="center"
        android:id="@+id/feedbackButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        app:icon="@drawable/ic_status_info_non_fill"
        app:iconGravity="textStart"
        app:iconTint="@color/textSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/unitTypeLabel"
        style="@style/OutlineTransparentButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
