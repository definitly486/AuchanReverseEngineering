<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/basics100"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/defaultLayout"
        android:background="@color/gray200"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/mapWebViewContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:layout_constraintHeight_default="percent"
            app:layout_constraintHeight_percent="0.8"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <android.webkit.WebView
                android:id="@+id/mapWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <include
                android:id="@+id/webViewProgress"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/progress"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/noMapLayout"
                android:background="@color/gray200"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/noMapImage"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/img_map_not_available"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.Body2Regular"
                    android:textColor="@color/gray600"
                    android:id="@+id/noMapText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/noMapImage"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/webViewTouchInterceptor"
                android:background="@android:color/transparent"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.cardview.widget.CardView
                    android:id="@+id/back_button"
                    android:background="@color/basics100"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="48dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="18dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="10dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_back"
                        android:tint="@color/gray900"/>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:gravity="end"
                    android:id="@+id/select_region_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/back_button"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.cardview.widget.CardView
                        android:background="@color/basics100"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="48dp"
                        android:layout_marginHorizontal="16dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="18dp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp">
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginRight="8dp"
                                android:src="@drawable/ic_location"/>
                            <TextView
                                android:textColor="@color/gray900"
                                android:ellipsize="end"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/current_region_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:lines="1"
                                style="@style/TextAppearance.Body2Medium"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/locateButton"
            android:background="@color/basics100"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="18dp"
            app:layout_constraintBottom_toTopOf="@+id/address_selector_popup"
            app:layout_constraintRight_toRightOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_location_arrow_fill"
                android:tint="@color/gray900"/>
        </androidx.cardview.widget.CardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/address_selector_popup"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:shapeAppearance="@style/TopCornersShape16">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <FrameLayout
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp">
                    <ImageView
                        android:id="@+id/puller"
                        android:layout_width="36dp"
                        android:layout_height="5dp"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/bottom_sheet_line"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/details_view"
                        android:paddingTop="9dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <include
                            android:id="@+id/delivery_layout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="16dp"
                            layout="@layout/address_store_part_delivery"/>
                        <FrameLayout
                            android:id="@+id/unavailableInfoContainer"
                            android:paddingBottom="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <crc64fac7521b55e1fcf3.SnackView
                                android:id="@+id/unavailableInfo"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                app:cellBackground="@drawable/bg_snack_warning_peach"
                                app:cellIcon="@drawable/ic_warning_snack"
                                app:cellTextColor="@color/text_warning"/>
                        </FrameLayout>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/pickupStoreList"
                            android:layout_width="match_parent"
                            android:layout_height="260dp"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/carPickupStoreList"
                            android:layout_width="match_parent"
                            android:layout_height="260dp"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                        <View
                            android:id="@+id/extraBottomSpace"
                            android:layout_width="match_parent"
                            android:layout_height="98dp"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:layout_gravity="top"
                    android:id="@+id/selectorPopupTouchInterceptor"
                    android:background="@android:color/transparent"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="25dp"/>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
        <FrameLayout
            android:id="@+id/saveButtonBackground"
            android:background="@color/basics100"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <View
                android:id="@+id/separator"
                android:background="@color/gray400"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_gravity="bottom"
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="34dp"
                android:textAllCaps="false"
                app:cornerRadius="8dp"
                style="@style/GreenMaterialRoundButtonDisabledGreen"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/global_progress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/progress"/>
    <FrameLayout
        android:id="@+id/error"
        android:background="@color/basics100"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/error"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/errorBackButton"
            android:background="@color/basics100"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="48dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="18dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="10dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_back"
                android:tint="@color/gray900"/>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
</FrameLayout>
