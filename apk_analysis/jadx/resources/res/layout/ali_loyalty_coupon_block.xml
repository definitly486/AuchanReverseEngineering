<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/coupons_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Мои купоны"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="20dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/coupons_indicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextAppearance.Title"/>
    <LinearLayout
        android:layout_gravity="center"
        android:id="@+id/coupons_indicator"
        android:background="@drawable/round_corners_12_red"
        android:paddingTop="1dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/coupons_title"
        app:layout_constraintEnd_toStartOf="@+id/empty_space"
        app:layout_constraintStart_toEndOf="@+id/coupons_title"
        app:layout_constraintTop_toTopOf="@+id/coupons_title">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/basics100"
            android:id="@+id/coupons_indicator_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 новых"
            android:fontFamily="sans-serif"
            android:lineHeight="14dp"
            android:textFontWeight="500"/>
    </LinearLayout>
    <View
        android:id="@+id/empty_space"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/coupons_title"
        app:layout_constraintEnd_toStartOf="@+id/allItemsButton"
        app:layout_constraintStart_toEndOf="@+id/coupons_indicator"
        app:layout_constraintTop_toTopOf="@+id/coupons_title"
        app:layout_constraintWidth_min="8dp"/>
    <include
        android:id="@+id/allItemsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/coupons_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/coupons_title"
        layout="@layout/layout_chevron_right_button"/>
    <p000auchan.SliderView
        android:id="@+id/coupons_slider_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/coupons_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
