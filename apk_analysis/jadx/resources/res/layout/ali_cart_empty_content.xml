<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top"
    android:orientation="vertical"
    android:background="@color/basics100"
    android:clipChildren="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/light_main"
        android:gravity="center"
        android:id="@+id/cartEmptyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/navigateToCatalogButton"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:id="@+id/navigateToCatalogButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:textAllCaps="false"
        android:backgroundTint="@color/green_material_button_selector"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toTopOf="@+id/navigateToFavoritesButton"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cartEmptyTitle"
        style="@style/DefaultMaterialButton"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/gray600"
        android:layout_gravity="center_horizontal"
        android:id="@+id/minOrderPriceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigateToCatalogButton"/>
    <Button
        android:textColor="@color/basics700"
        android:id="@+id/navigateToFavoritesButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:textAllCaps="false"
        android:backgroundTint="@color/gray200"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toTopOf="@+id/retry_last_order_button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigateToCatalogButton"
        style="@style/DefaultMaterialButton"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/retry_last_order_button"
        android:background="@drawable/bg_rounded_border_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/ui_brand"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toTopOf="@+id/empty_recommendations_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigateToFavoritesButton">
        <TextView
            android:textAppearance="@style/TextAppearance.Body2Medium"
            android:textColor="@color/light_main"
            android:id="@+id/cart_retry_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:lines="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/cart_retry_image_button"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/cart_retry_image_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textAppearance="@style/TextAppearance.Body2Medium"
                android:textColor="@color/ui_brand"
                android:id="@+id/cart_retry_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Перейти"
                android:layout_marginEnd="2dp"/>
            <ImageView
                android:layout_gravity="bottom"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right_green"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/last_order_products"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:paddingHorizontal="1dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cart_retry_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
