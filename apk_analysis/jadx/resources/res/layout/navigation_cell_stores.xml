<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/custom_ripple"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/navigation_cell_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginLeft="20dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/light_main"
            android:ellipsize="end"
            android:gravity="top|left"
            android:layout_gravity="center_vertical"
            android:id="@+id/navigation_cell_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="13dp"
            android:layout_weight="1"
            android:translationY="-1dp"
            android:fontFamily="sans-serif"
            android:textAlignment="gravity"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="14dp"
            android:textFontWeight="500"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/navigation_cell_unread_view"
            android:background="@drawable/bg_unread_message_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="12dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/basics100"
                android:id="@+id/navigation_cell_unread_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="6dp"
            android:layout_height="12dp"
            android:layout_marginRight="28dp"
            android:src="@drawable/ic_small_chevron_right"/>
    </LinearLayout>
    <View
        android:id="@+id/navigation_cell_separator"
        android:background="@color/separatorColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
