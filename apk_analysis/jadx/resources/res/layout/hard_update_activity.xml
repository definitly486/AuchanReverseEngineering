<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/buttonsBlock"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/hardUpdateImageView"
            android:layout_width="224dp"
            android:layout_height="168dp"
            android:src="@drawable/hard_update_image"/>
        <TextView
            android:id="@+id/hardUpdateMessageTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            style="@style/DefaultSemiboldLabel"/>
        <TextView
            android:id="@+id/hardUpdateHintTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/hard_update_hint_message"
            style="@style/HintLabel"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/buttonsBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/hardUpdateQRCodeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Показать карту лояльности"
            android:textAllCaps="false"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            style="@style/DefaultLightGrayButton"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/hardUpdateUpdateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hard_update_update_button"
            android:textAllCaps="false"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            style="@style/DefaultPrimarydButton"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
