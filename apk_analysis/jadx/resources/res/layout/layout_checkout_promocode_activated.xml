<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/red_orange"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="1dp"
        app:cardCornerRadius="8dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/points_image"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="19dp"
                android:layout_marginTop="21dp"
                android:src="@drawable/ic_checkout_coupons"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/basics700"
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="Промокод"
                app:layout_constraintBottom_toBottomOf="@+id/points_image"
                app:layout_constraintLeft_toRightOf="@+id/points_image"
                app:layout_constraintTop_toTopOf="@+id/points_image"/>
            <ImageView
                android:id="@+id/hide_image"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="21dp"
                android:layout_marginRight="16dp"
                android:src="@drawable/ic_checkout_minus"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <crc64fac7521b55e1fcf3.TextViewWithOk
                android:id="@+id/promocode_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="20dp"
                app:layout_constraintTop_toBottomOf="@+id/title_text"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/promocode_error_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="31dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/promocode_view">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/danger200"
                    android:id="@+id/promocode_error_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineHeight="16sp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/danger200"
                    android:id="@+id/promocode_error_link_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineHeight="16sp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.cardview.widget.CardView>
