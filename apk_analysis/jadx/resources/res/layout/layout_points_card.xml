<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="#fff"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:weightSum="1">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/points_layout"
        android:background="@drawable/bg_rounded_border_8_loyalty"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginRight="8dp"
        android:layout_weight="0.5">
        <ImageView
            android:id="@+id/yellow_coin"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="8dp"
            android:src="@drawable/ic_yellow_coin"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_loyalty_tab_text"
            android:id="@+id/points_title_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:translationY="-1dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_loyalty_tab_text"
            android:id="@+id/points_int_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:translationY="-1dp"
            android:fontFamily="sans-serif"
            android:textFontWeight="700"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/color_loyalty_tab_text_fraction"
            android:id="@+id/points_fraction_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:translationY="-2.5dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/stamps_layout"
        android:background="@drawable/bg_rounded_border_8_loyalty"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.5">
        <ImageView
            android:id="@+id/stamp_image"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="8dp"
            android:src="@drawable/ic_loyalty_mark"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_loyalty_tab_text"
            android:id="@+id/stamps_title_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:translationY="-1dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_loyalty_tab_text"
            android:id="@+id/stamps_int_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:translationY="-1dp"
            android:fontFamily="sans-serif"
            android:textFontWeight="700"/>
    </LinearLayout>
</LinearLayout>
