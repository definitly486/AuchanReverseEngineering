<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/lastOrderInformer"
    android:background="@drawable/bg_top_corner_16_basics_100"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="14dp"
    android:paddingHorizontal="20dp"
    android:paddingVertical="16dp">
    <androidx.cardview.widget.CardView
        android:id="@+id/imageBackground"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:backgroundTint="@color/ui_brand"
        app:cardCornerRadius="19dp"
        app:cardElevation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/image"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/basics100"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textAppearance="@style/TextAppearance.Body1Medium"
        android:textColor="@color/light_main"
        android:id="@+id/orderInformerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintLeft_toRightOf="@+id/imageBackground"
        app:layout_constraintRight_toLeftOf="@+id/rightChevron"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.SubtextRegular"
        android:textColor="@color/textSecondary"
        android:id="@+id/orderInformerDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/imageBackground"
        app:layout_constraintRight_toLeftOf="@+id/rightChevron"
        app:layout_constraintTop_toBottomOf="@+id/orderInformerTitle"/>
    <ImageView
        android:id="@+id/rightChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron_right_grey"
        android:tint="@color/gray900"
        app:layout_constraintBottom_toBottomOf="@+id/orderInformerTitle"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/orderInformerTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
