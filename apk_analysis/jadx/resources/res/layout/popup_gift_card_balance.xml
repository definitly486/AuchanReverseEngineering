<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/default_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/bottomSheetLine"
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/bottom_sheet_line"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/basics600"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/card_number_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Номер карты"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:endIconMode="none"
                app:errorIconDrawable="@null"
                style="@style/DefaultInputLayout.Grey">
                <com.google.android.material.textfield.TextInputEditText
                    android:textColor="@color/shark"
                    android:ellipsize="none"
                    android:id="@+id/card_number_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789 "
                    android:editable="true"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    app:emojiCompatEnabled="false"/>
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/card_pin_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="ПИН-код"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    app:endIconMode="none"
                    app:errorIconDrawable="@null"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/DefaultInputLayout.Grey">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textColor="@color/shark"
                        android:ellipsize="none"
                        android:id="@+id/card_pin_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:editable="true"
                        android:inputType="numberPassword"
                        android:imeOptions="actionDone"/>
                </com.google.android.material.textfield.TextInputLayout>
                <ImageView
                    android:id="@+id/card_pin_show_button"
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ic_show_password"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintEnd_toEndOf="@+id/card_pin_input_layout"
                    app:layout_constraintTop_toTopOf="@+id/card_pin_input_layout"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/balance_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:textAllCaps="false"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                style="@style/DefaultGreenButton"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/basics450"
                android:id="@+id/card_expiry_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/basics600"
                android:id="@+id/card_expiry_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/basics450"
                android:id="@+id/card_balance_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/basics600"
                android:id="@+id/card_balance_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/ok_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:textAllCaps="false"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                style="@style/DefaultGreenButton"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/defaultButtonColor"
                android:gravity="center"
                android:id="@+id/feedback_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:textFontWeight="600"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/card_error_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/bottom_sheet_line"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/basics600"
                    android:id="@+id/card_error_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/close_button"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_close_dark"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="224dp"
                android:layout_height="168dp"
                android:layout_marginTop="13dp"
                android:src="@drawable/bg_card_balance_error"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/basics500"
                android:gravity="center"
                android:id="@+id/card_error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAlignment="center"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/defaultButtonColor"
                android:gravity="center"
                android:id="@+id/card_error_feedback_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:textFontWeight="600"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/error_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/bottom_sheet_line"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">
                <ImageView
                    android:id="@+id/close_button"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_close_dark"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="224dp"
                android:layout_height="140dp"
                android:layout_marginTop="13dp"
                android:src="@drawable/ic_bird_error"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/basics700"
                android:gravity="center"
                android:id="@+id/error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAlignment="center"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/defaultButtonColor"
                android:gravity="center"
                android:id="@+id/error_feedback_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:textFontWeight="600"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/error_retry_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:textAllCaps="false"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                style="@style/DefaultGreenButton"/>
        </LinearLayout>
        <Space
            android:id="@+id/progress_top_spacer"
            android:layout_width="match_parent"
            android:layout_height="120dp"/>
        <include
            android:id="@+id/progress_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/progress"/>
        <Space
            android:id="@+id/progress_bottom_spacer"
            android:layout_width="match_parent"
            android:layout_height="120dp"/>
    </LinearLayout>
</FrameLayout>
