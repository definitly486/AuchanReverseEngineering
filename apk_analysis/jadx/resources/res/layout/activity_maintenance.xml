<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/basics100"
    android:paddingBottom="34dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scrollview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@+id/action_button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/icon"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginTop="85dp"
                android:src="@drawable/ic_maintenance"/>
            <TextView
                android:textAppearance="@style/TextAppearance.Subhead1Bold"
                android:textColor="@color/light_main"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@+id/icon"/>
            <TextView
                android:textAppearance="@style/TextAppearance.Body2Regular"
                android:textColor="@color/textSecondary"
                android:gravity="center"
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="27.5dp"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/infoView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/informations100"
                android:layout_marginHorizontal="27.5dp"
                app:cardCornerRadius="8dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_info_blue_24x24"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Body2Regular"
                        android:textColor="@color/text_info"
                        android:id="@+id/infoTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton
        android:theme="@style/DefaultGreenMaterialRoundButton"
        android:id="@+id/action_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:textAllCaps="false"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="16dp"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_maintenance_refresh"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toTopOf="@+id/qr_code_button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollview"
        style="@style/DefaultGreenMaterialRoundButton"/>
    <com.google.android.material.button.MaterialButton
        android:theme="@style/LightGrayMaterialRoundButton"
        android:id="@+id/qr_code_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="16dp"
        android:textAllCaps="false"
        android:layout_marginHorizontal="20dp"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/LightGrayMaterialRoundButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
