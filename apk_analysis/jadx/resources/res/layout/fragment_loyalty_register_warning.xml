<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="20dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="20dp"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Title"
        android:gravity="center"
        android:id="@+id/title_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/icon"
        android:layout_width="224dp"
        android:layout_height="168dp"
        android:src="@drawable/auchan_sad_face_logo"
        app:layout_constraintBottom_toTopOf="@+id/hint_title"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/title_label"
        app:layout_constraintVertical_bias="0.7"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/shark"
        android:gravity="center_horizontal"
        android:id="@+id/hint_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/hint_message"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/oslo_gray"
        android:gravity="center_horizontal"
        android:id="@+id/hint_message"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="6dp"
        app:autoSizeMaxTextSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/reject_button"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintHeight_percent="0.13"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="16sp"
        android:textColor="@color/redButtonColor"
        android:id="@+id/reject_button"
        android:background="@drawable/outline_red_button"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="16dp"
        android:textAllCaps="false"
        app:layout_constraintBottom_toTopOf="@+id/proceed_button"
        app:layout_constraintEnd_toStartOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/proceed_button"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        style="@style/DefaultRedButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
