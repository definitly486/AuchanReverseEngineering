<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <ImageView
        android:id="@+id/item_icon"
        android:background="@drawable/bg_loyalty_balls"
        android:padding="11dp"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/ic_loyalty_balls_android"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Body2Medium"
        android:textSize="14sp"
        android:textColor="@color/light_main"
        android:id="@+id/title_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/value_label"
        app:layout_constraintStart_toEndOf="@+id/item_icon"
        app:layout_constraintTop_toTopOf="@+id/item_icon"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Body2Regular"
        android:textSize="12sp"
        android:textColor="@color/gray600"
        android:id="@+id/time_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_icon"
        app:layout_constraintEnd_toStartOf="@+id/value_label"
        app:layout_constraintStart_toEndOf="@+id/item_icon"
        app:layout_constraintTop_toBottomOf="@+id/title_label"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Body2Medium"
        android:textSize="14sp"
        android:textColor="@color/light_main"
        android:id="@+id/value_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="2dp"
        app:layout_constraintEnd_toStartOf="@+id/fire"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/fire"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_fire"
        app:layout_constraintBottom_toBottomOf="@+id/value_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/value_label"/>
</androidx.constraintlayout.widget.ConstraintLayout>
