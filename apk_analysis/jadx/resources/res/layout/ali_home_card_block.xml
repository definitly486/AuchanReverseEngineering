<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <HorizontalScrollView
        android:id="@+id/card_section"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/cardSectionLayout"
            android:background="@color/basics100"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <include
                android:id="@+id/for_business_card"
                android:layout_width="103dp"
                android:layout_height="96dp"
                android:layout_marginEnd="10dp"
                layout="@layout/li_home_card"/>
            <include
                android:id="@+id/sales_and_news_card"
                android:layout_width="103dp"
                android:layout_height="96dp"
                android:layout_marginEnd="10dp"
                layout="@layout/li_home_card"/>
            <include
                android:id="@+id/shop_card"
                android:layout_width="103dp"
                android:layout_height="96dp"
                layout="@layout/li_home_card"/>
        </LinearLayout>
    </HorizontalScrollView>
</FrameLayout>
