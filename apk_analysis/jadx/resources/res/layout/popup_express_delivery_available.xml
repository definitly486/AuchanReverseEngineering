<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/card"
        android:padding="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginVertical="10dp"
        app:cardBackgroundColor="@color/basics100">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/close"
                android:clickable="false"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_dark_close_cross"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/gray900"/>
            <ImageView
                android:clickable="false"
                android:layout_width="13.72dp"
                android:layout_height="7.82dp"
                android:layout_marginTop="1.4dp"
                android:src="@mipmap/img_robin"
                android:layout_marginStart="20.65dp"
                app:layout_constraintLeft_toLeftOf="@+id/logo"
                app:layout_constraintTop_toTopOf="@+id/logo"/>
            <ImageView
                android:id="@+id/logo"
                android:clickable="false"
                android:layout_width="48dp"
                android:layout_height="31dp"
                android:src="@drawable/img_delivery_moto"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textAppearance="@style/TextAppearance.SubtextMedium"
                android:textColor="@color/light_main"
                android:id="@+id/text"
                android:clickable="false"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/close"
                app:layout_constraintStart_toEndOf="@+id/logo"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</FrameLayout>
