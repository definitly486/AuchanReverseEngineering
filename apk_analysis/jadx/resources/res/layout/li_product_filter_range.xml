<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/basics100"
    android:layout_width="match_parent"
    android:layout_height="136dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/basics700"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/edit_layout"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="@color/basics450"
            android:id="@+id/from_text_layout"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:hint="от"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="5dp"
            app:boxBackgroundColor="@color/basics200"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:endIconMode="none"
            app:errorEnabled="false"
            app:errorTextColor="@color/basics450"
            app:hintTextColor="@color/basics450"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Rounded8">
            <com.google.android.material.textfield.TextInputEditText
                android:textSize="16sp"
                android:textColor="@color/basics700"
                android:ellipsize="end"
                android:id="@+id/from_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:editable="false"
                android:inputType="number"
                android:fontFamily="sans-serif"
                android:textFontWeight="500"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="—"
            android:fontFamily="sans-serif"
            android:textFontWeight="500"/>
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="@color/basics450"
            android:id="@+id/to_text_layout"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:hint="до"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="20dp"
            app:boxBackgroundColor="@color/basics200"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:endIconMode="none"
            app:errorEnabled="false"
            app:errorTextColor="@color/basics450"
            app:hintTextColor="@color/basics450"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Rounded8">
            <com.google.android.material.textfield.TextInputEditText
                android:textSize="16sp"
                android:textColor="@color/basics700"
                android:ellipsize="end"
                android:id="@+id/to_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:editable="false"
                android:inputType="number"
                android:fontFamily="sans-serif"
                android:textFontWeight="500"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <crc64d528ded20b131891.RangeSliderControl
        android:id="@+id/range_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:absoluteMaxValue="100"
        app:absoluteMinValue="0"
        app:activeColor="@color/primary02_500"
        app:alwaysActive="true"
        app:barHeight="4dp"
        app:defaultColor="@color/gray400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_layout"
        app:maxThumbHidden="false"
        app:minThumbHidden="false"
        app:showRangeLabels="false"
        app:stepValue="1"
        app:thumbDisabled="@drawable/ic_range_slider_thumb"
        app:thumbNormal="@drawable/ic_range_slider_thumb"
        app:thumbPressed="@drawable/ic_range_slider_thumb"
        app:thumbShadow="@null"
        app:valuesAboveThumbs="false"/>
    <View
        android:id="@+id/block_view"
        android:background="#99ffffff"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
