<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp">
        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/radioButton"
            android:clickable="false"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/address_info"
            style="@style/RadioButtonGreen"/>
        <ImageView
            android:id="@+id/edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_address_edit"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/gray600"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/address_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/edit"
            app:layout_constraintStart_toEndOf="@+id/radioButton"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textAppearance="@style/DefaultLabel"
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textAppearance="@style/TextAppearance.Body2Regular"
                android:textColor="@color/textSecondary"
                android:id="@+id/address"
                android:paddingTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textAppearance="@style/TextAppearance.Body2Regular"
                android:textColor="@color/primary400"
                android:id="@+id/addressWarningText"
                android:paddingTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/deliveryTypeLayout"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/deliveryTypeButtonsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include
                        android:id="@+id/deliveryTypeExpress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        layout="@layout/layout_delivery_type_button"/>
                    <include
                        android:id="@+id/deliveryTypeStandard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        layout="@layout/layout_delivery_type_button"/>
                    <View
                        android:id="@+id/invisibleBalanceView"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_rounded_8_gray200"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/deliveryShortInfoImageView"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_pickup_20x20"
                            android:layout_marginEnd="8dp"
                            app:tint="@color/gray600"/>
                        <TextView
                            android:textAppearance="@style/TextAppearance.Body2Medium"
                            android:textColor="@color/textSecondary"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/deliveryShortInfoTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_cart"
                            android:layout_marginEnd="8dp"
                            app:tint="@color/gray600"/>
                        <TextView
                            android:textAppearance="@style/TextAppearance.Body2Medium"
                            android:textColor="@color/textSecondary"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/deliveryMinCostTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/freeDeliveryFromView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/freeDeliveryFromImageView"
                            android:layout_width="16dp"
                            android:layout_height="19dp"
                            android:src="@drawable/ic_standard_delivery"
                            android:layout_marginEnd="8dp"
                            app:tint="@color/gray600"/>
                        <TextView
                            android:textAppearance="@style/TextAppearance.Body2Medium"
                            android:textColor="@color/textSecondary"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/freeDeliveryFromTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/bottomSeparator"
        android:background="@color/gray400"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</LinearLayout>
