<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:contentInsetStart="0dp"
        app:title="Програма лояльности АШАН">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/back_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/ToolbarImageButton.Back"/>
            <TextView
                android:textSize="@dimen/toolbar_title_size"
                android:textStyle="bold"
                android:textColor="@color/shark"
                android:gravity="center"
                android:id="@+id/toolbar_title"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/right_button"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_logout"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/ToolbarImageButton"/>
            <View
                android:id="@+id/scrolled_line_view"
                android:background="@color/catskill_white"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="start"
                android:layout_width="102dp"
                android:layout_height="102dp"
                android:layout_marginTop="13dp"
                android:src="@drawable/ic_tooltips_staff_bird"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <TextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/basics700"
                android:id="@+id/details_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <p000auchan.HighlightedTextView
                android:textSize="14sp"
                android:textColor="@color/basics700"
                android:id="@+id/details_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="sans-serif"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:textAppearanceHighlighted="@style/TextAppearance.LoginMessageHighlighted"/>
            <crc64fac7521b55e1fcf3.NavigationCellView
                android:id="@+id/privileges_club_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cellIcon="@drawable/ic_document"
                app:cellText="@string/profile_documents"/>
            <crc64fac7521b55e1fcf3.NavigationCellView
                android:id="@+id/loyalty_rules_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cellIcon="@drawable/ic_document"
                app:cellText="@string/profile_documents"
                app:cellTextLines="2"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="16sp"
        android:id="@+id/block_card_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="15dp"
        android:textAllCaps="false"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/OutlineRedButton"/>
</LinearLayout>
