<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/basics700_alpha40"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/basics100"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        app:contentInsetStart="0dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/search_view"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp">
                    <p000auchan.CustomSearchView
                        android:textColor="@color/light_main"
                        android:textColorHint="#636c78"
                        android:id="@+id/query_edit_text"
                        android:focusable="false"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:inputType="none"
                        android:paddingEnd="18dp"
                        app:closeIcon="@null"
                        app:iconifiedByDefault="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:queryBackground="@null"
                        app:queryHint="Поиск"
                        app:searchIcon="@drawable/ic_search_gray"
                        style="@style/SearchView.Grey200"/>
                    <ImageView
                        android:id="@+id/query_edit_text_clear"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:src="@drawable/ic_close_dark"
                        android:layout_marginEnd="12dp"
                        app:layout_constraintBottom_toBottomOf="@+id/query_edit_text"
                        app:layout_constraintEnd_toEndOf="@+id/query_edit_text"
                        app:layout_constraintTop_toTopOf="@+id/query_edit_text"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textAppearance="@style/TextAppearance.Body1Medium"
                    android:textColor="@color/primary02_TextActive"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cancel_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="textEnd"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="20dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:orientation="vertical"
            android:id="@+id/content_app_bar_layout"
            android:background="@color/basics100"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stateListAnimator="@null">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/autohints_recycler_view"
                android:background="@color/basics100"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/product_list"
            android:background="@color/gray200"
            android:paddingBottom="20dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/filters_container"
            android:background="@color/white"
            android:paddingTop="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <include
                android:layout_width="match_parent"
                android:layout_height="24dp"
                layout="@layout/search_filters_view"/>
            <View
                android:id="@+id/nav_bar_separator"
                android:background="@color/gray400"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"/>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/empty_state_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@color/basics100"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:minHeight="27dp"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/empty_image"
                android:layout_width="224dp"
                android:layout_height="168dp"
                android:src="@drawable/ic_search_empty"/>
            <TextView
                android:textAppearance="@style/TextAppearance.HeaderAuth"
                android:textColor="@color/light_main"
                android:gravity="center"
                android:id="@+id/empty_title_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <TextView
                android:textAppearance="@style/TextAppearance.Body2Regular"
                android:textColor="@color/textSecondary"
                android:gravity="center"
                android:id="@+id/empty_hint_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:minHeight="32dp"
                android:layout_weight="1"/>
            <p000auchan.RecommendationsView
                android:id="@+id/empty_recommendations_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:all_sections_bottom_margin="16dp"
                app:always_hide_divider="true"
                app:section_left_margin="20dp"
                app:section_right_margin="20dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:id="@+id/progress_view"
        layout="@layout/progress"/>
</LinearLayout>
