<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/time_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">
    <TextView
        android:textAppearance="@style/TextAppearance.Body1Regular"
        android:textColor="@color/light_main"
        android:id="@+id/timeHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:lineHeight="24sp"/>
    <ImageView
        android:id="@+id/timePriceIcon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_demand"
        android:layout_marginEnd="2dp"/>
    <TextView
        android:textAppearance="@style/TextAppearance.SubtextRegular"
        android:textColor="@color/text_secondary"
        android:id="@+id/timePrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/timeRadio"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/radio_selector_green_selected"
        android:layout_marginStart="12dp"/>
</LinearLayout>
