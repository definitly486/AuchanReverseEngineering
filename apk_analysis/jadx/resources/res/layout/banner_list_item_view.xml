<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bannerCell"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintHorizontal_weight="1"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintWidth_default="spread">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bannerImageViewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/bannerImageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.card.MaterialCardView>
    <FrameLayout
        android:id="@+id/indicator"
        android:layout_width="10dp"
        android:layout_height="10dp"
        app:layout_constraintRight_toRightOf="@+id/bannerImageViewContainer"
        app:layout_constraintTop_toTopOf="@+id/bannerImageViewContainer">
        <View
            android:id="@+id/indicator_background"
            android:background="@drawable/rounded_corners_5_white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:background="@drawable/rounded_corners_4_red"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginLeft="1dp"
            android:layout_marginTop="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/indicator_background"
            app:layout_constraintLeft_toLeftOf="@+id/indicator_background"
            app:layout_constraintRight_toRightOf="@+id/indicator_background"
            app:layout_constraintTop_toTopOf="@+id/indicator_background"/>
    </FrameLayout>
    <TextView
        android:id="@+id/bannerTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Title"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bannerImageViewContainer"
        style="@style/HomeMediumLabel"/>
    <TextView
        android:id="@+id/bannerTimeTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:text="time"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bannerTitleTextView"
        style="@style/HomeSmallLabel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
