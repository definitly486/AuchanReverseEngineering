<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/defaultLayout"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/start_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="20dp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/end_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="20dp"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/fname_input_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/DefaultInputLayout.Auth">
                <crc64fac7521b55e1fcf3.OutlinedErrorEditText
                    android:textColor="@color/black"
                    android:id="@+id/fname_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:layout_marginStart="16dp"
                    app:emojiCompatEnabled="false"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/email_input_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="4dp"
                app:endIconDrawable="@drawable/ic_green_check_mark"
                app:endIconMode="custom"
                app:endIconTint="@color/emerald"
                app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fname_input_layout"
                style="@style/DefaultInputLayout.Auth">
                <crc64fac7521b55e1fcf3.OutlinedErrorEditText
                    android:textColor="@color/black"
                    android:id="@+id/email_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:layout_marginStart="16dp"
                    app:emojiCompatEnabled="false"/>
            </com.google.android.material.textfield.TextInputLayout>
            <FrameLayout
                android:id="@+id/dob_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/email_input_layout">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/dusty_gray"
                    android:id="@+id/dob_input_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="36dp"
                    android:layout_marginTop="24dp"
                    android:elevation="4dp"
                    android:letterSpacing="0"
                    android:textFontWeight="500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/dob_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:endIconDrawable="@drawable/ic_green_check_mark"
                    app:endIconMode="custom"
                    app:endIconTint="@color/emerald"
                    style="@style/DefaultInputLayout.Auth">
                    <crc64fac7521b55e1fcf3.OutlinedErrorEditText
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:id="@+id/dob_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="date"
                        android:layout_marginStart="16dp"
                        android:letterSpacing="0"
                        android:textFontWeight="500"
                        app:emojiCompatEnabled="false"/>
                </com.google.android.material.textfield.TextInputLayout>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/gender_group"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                app:layout_constraintStart_toStartOf="@+id/start_guideline"
                app:layout_constraintTop_toBottomOf="@+id/dob_layout">
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/textSecondary"
                    android:gravity="center"
                    android:id="@+id/gender_male_button"
                    android:background="@drawable/bg_rounded_border_8_gray400"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/textSecondary"
                    android:gravity="center"
                    android:id="@+id/gender_female_button"
                    android:background="@drawable/bg_rounded_border_8_gray400"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/have_plastic_card_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                app:layout_constraintStart_toStartOf="@+id/start_guideline"
                app:layout_constraintTop_toBottomOf="@+id/gender_group"
                style="@style/CheckBoxTextSignup"/>
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/have_plastic_card_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                app:layout_constraintStart_toStartOf="@+id/start_guideline"
                app:layout_constraintTop_toBottomOf="@+id/have_plastic_card_textview">
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:textSize="16sp"
                    android:textColor="@color/light_main"
                    android:id="@+id/have_button"
                    android:paddingLeft="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Да"
                    app:useMaterialThemeColors="false"/>
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:textSize="16sp"
                    android:textColor="@color/light_main"
                    android:id="@+id/no_have_button"
                    android:paddingLeft="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Нет"
                    android:layout_marginStart="24dp"
                    app:useMaterialThemeColors="false"/>
            </RadioGroup>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/have_plastic_card_group">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/textSecondary"
                    android:id="@+id/roll_card_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/card_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="1">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/card_number_input_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:layout_marginStart="4dp"
                        app:endIconMode="custom"
                        app:errorEnabled="true"
                        app:errorIconDrawable="@null"
                        app:helperTextEnabled="true"
                        style="@style/DefaultInputLayout.Auth">
                        <crc64fac7521b55e1fcf3.OutlinedErrorEditText
                            android:textColor="@color/black"
                            android:id="@+id/card_number_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="01234567890* "
                            android:inputType="number"
                            android:imeOptions="actionNext"
                            android:layout_marginStart="16dp"
                            app:emojiCompatEnabled="false"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/card_cvc_input_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:layout_marginStart="-8dp"
                        app:endIconDrawable="@drawable/ic_loyalty_card_cvc"
                        app:endIconMode="none"
                        app:errorEnabled="true"
                        app:errorIconDrawable="@null"
                        style="@style/DefaultInputLayout.Auth">
                        <crc64fac7521b55e1fcf3.OutlinedErrorEditText
                            android:textColor="@color/black"
                            android:id="@+id/card_cvc_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberPassword"
                            android:layout_marginStart="16dp"
                            app:emojiCompatEnabled="false"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cvc_hint"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/card_cvc_input_layout"
                app:layout_constraintEnd_toEndOf="@+id/card_cvc_input_layout"
                app:layout_constraintStart_toStartOf="@+id/card_cvc_input_layout">
                <View
                    android:id="@+id/triangle_view"
                    android:background="@color/warning100"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:rotation="45"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardPreventCornerOverlap="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:background="@color/warning100"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/info_image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:src="@drawable/ic_warning_orange"
                            android:scaleType="centerCrop"
                            android:layout_marginStart="12dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/basics500"
                            android:id="@+id/cvc_hint_message_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/info_image"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/separator"
                android:background="#f0f2f5"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                app:layout_constraintStart_toStartOf="@+id/start_guideline"
                app:layout_constraintTop_toBottomOf="@+id/info"/>
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/want_receive_checkbox"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="13dp"
                app:layout_constraintBottom_toBottomOf="@+id/want_receive_textview"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/want_receive_textview"
                app:theme="@style/CheckboxSimpleStyle"/>
            <TextView
                android:id="@+id/want_receive_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                app:layout_constraintStart_toEndOf="@+id/want_receive_checkbox"
                app:layout_constraintTop_toBottomOf="@+id/separator"
                style="@style/CheckBoxTextSignup"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sign_up_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toStartOf="@+id/end_guideline"
                app:layout_constraintStart_toStartOf="@+id/start_guideline"
                app:layout_constraintTop_toBottomOf="@+id/want_receive_textview"
                style="@style/GreenMaterialRoundButtonDisabledGreen"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#686c75"
                android:gravity="center"
                android:id="@+id/legal_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:textAlignment="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/end_guideline"
                app:layout_constraintStart_toStartOf="@+id/start_guideline"
                app:layout_constraintTop_toBottomOf="@+id/sign_up_button"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:id="@+id/progressLayout"
            android:visibility="gone"
            layout="@layout/progress"/>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
