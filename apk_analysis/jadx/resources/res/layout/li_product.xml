<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="162dp"
    android:layout_height="288dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="18dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/last_item_state"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/green_primary"
            app:cardCornerRadius="12dp">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                app:cardCornerRadius="12dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:layout_marginBottom="12dp"
                        android:src="@drawable/arrow_right"
                        app:layout_constraintBottom_toTopOf="@+id/show_all_text"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <TextView
                        android:textColor="@color/green_primary"
                        android:id="@+id/show_all_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Показать всё"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </androidx.cardview.widget.CardView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/default_item_state"
            android:paddingTop="0dp"
            android:paddingBottom="8dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/favorite_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:translationZ="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/subscribe_top_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:translationZ="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/favorite_button"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/salesLayout"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="8dp"
                android:translationZ="1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <p000auchan.BadgesView
                    android:id="@+id/badgesLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/product_image_container"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/product_images"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <include
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    layout="@layout/layout_adults_overlay"/>
            </FrameLayout>
            <me.relex.circleindicator.CircleIndicator
                android:gravity="center"
                android:id="@+id/product_images_indicator"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="4dp"
                android:layout_marginEnd="8dp"
                app:ci_animator="@animator/no_op"
                app:ci_drawable="@drawable/ic_card_pager_dot_active"
                app:ci_drawable_unselected="@drawable/ic_card_pager_dot_inactive"
                app:ci_height="4dp"
                app:ci_margin="2dp"
                app:ci_width="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/product_image_container"
                app:layout_constraintEnd_toEndOf="parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/ratingLayout"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/product_image_container"
                app:layout_constraintVertical_bias="0.5">
                <ImageView
                    android:id="@+id/starImageView"
                    android:layout_width="16dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_star_gold"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/light_main"
                    android:gravity="center_vertical"
                    android:id="@+id/ratingTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:text="4.5"
                    android:fontFamily="sans-serif-medium"/>
                <ImageView
                    android:id="@+id/cloudImageView"
                    android:layout_width="16dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8dp"
                    android:src="@drawable/ic_cloud"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical"
                    android:id="@+id/reviewCountTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:text="10"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <p000auchan.HighlightedTextView
                android:textSize="12sp"
                android:id="@+id/hint_label"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:translationZ="2dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextAppearance.NoMoreGoods"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/light_main"
                android:ellipsize="end"
                android:id="@+id/title_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lines="2"
                android:includeFontPadding="false"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ratingLayout"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/ui_gray_600"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/package_label"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title_label"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/price_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toTopOf="@+id/bottom_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/action_clickable_view"
                    android:background="@drawable/bg_rounded_8_green"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/ic_card_plus"
                    android:scaleType="center"
                    android:contentDescription="@null"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/promoLayout"
                    app:layout_goneMarginTop="0dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/price_block"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/action_clickable_view"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/promoLayout"
                    app:layout_goneMarginEnd="0dp"
                    app:layout_goneMarginTop="0dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/light_main"
                        android:gravity="start|center_vertical"
                        android:id="@+id/price_label"
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        app:autoSizeMaxTextSize="16sp"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:id="@+id/old_price_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/price_label"/>
                    <View
                        android:id="@+id/old_price_crossing_line"
                        android:background="@color/monza"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:rotation="-18"
                        app:layout_constraintBottom_toBottomOf="@+id/old_price_label"
                        app:layout_constraintEnd_toEndOf="@+id/old_price_label"
                        app:layout_constraintStart_toStartOf="@+id/old_price_label"
                        app:layout_constraintTop_toTopOf="@+id/old_price_label"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/promoLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/tags_sale"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/discount_by_loyalty_program"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/tags_sale"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/discount_prefix"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="3dp"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/discount_end_date"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/adding_state_view"
                    android:background="@drawable/bg_rounded_8_ui_gray_200"
                    android:visibility="gone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1"
                    app:layout_constraintStart_toStartOf="parent">
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/decrease_button"
                        android:background="@drawable/card_counter_button_bg_selector"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_card_minus"
                        android:scaleType="center"
                        android:contentDescription="@null"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/counter_middle"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/increase_button"
                        app:layout_constraintStart_toEndOf="@+id/decrease_button"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:id="@+id/count_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:fontFamily="sans-serif-medium"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/light_main"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/price_sub_total"
                            android:layout_width="0dp"
                            android:layout_height="15dp"
                            android:layout_marginBottom="4dp"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:fontFamily="sans-serif-medium"
                            app:autoSizeMaxTextSize="12sp"
                            app:autoSizeMinTextSize="9sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/increase_button"
                        android:background="@drawable/card_counter_button_bg_selector"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_card_plus"
                        android:scaleType="center"
                        android:contentDescription="@null"
                        android:layout_marginEnd="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bottom_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="14sp"
                    android:textColor="@color/light_main"
                    android:gravity="center"
                    android:id="@+id/subscribe_bottom_button"
                    android:background="@drawable/bg_rounded_8_gray200"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:textAllCaps="false"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:textFontWeight="500"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/out_of_stock_view"
                        android:visibility="gone"
                        android:clipChildren="false"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary"
                            android:id="@+id/out_of_stock_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toTopOf="@+id/available_in_shop_text"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/light_main"
                            android:id="@+id/available_in_shop_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:fontFamily="sans-serif-medium"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/out_of_stock_text"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textSize="14sp"
                        android:textColor="@color/light_main"
                        android:gravity="center"
                        android:id="@+id/find_replacement_button"
                        android:background="@drawable/bg_rounded_8_gray200"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:textAllCaps="false"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:textFontWeight="500"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
