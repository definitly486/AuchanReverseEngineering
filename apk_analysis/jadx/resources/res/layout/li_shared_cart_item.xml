<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:paddingTop="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <ImageView
        android:id="@+id/image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.25"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Body2Regular"
        android:textColor="@color/light_main"
        android:ellipsize="end"
        android:id="@+id/cartItemTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="2"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.HintMedium"
        android:textColor="@color/text_secondary"
        android:id="@+id/cartPricePerItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="0dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toBottomOf="@+id/cartItemTitle"/>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="@color/gray600"
        app:cardCornerRadius="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/cartPricePerItem"
        app:layout_constraintStart_toEndOf="@+id/cartPricePerItem"
        app:layout_constraintTop_toTopOf="@+id/cartPricePerItem"/>
    <TextView
        android:textAppearance="@style/TextAppearance.HintMedium"
        android:textColor="@color/text_secondary"
        android:id="@+id/itemsCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/cartPricePerItem"
        app:layout_constraintStart_toEndOf="@+id/cartPricePerItem"
        app:layout_constraintTop_toTopOf="@+id/cartPricePerItem"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Body1Medium"
        android:textSize="14sp"
        android:textColor="@color/light_main"
        android:id="@+id/cartItemPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toBottomOf="@+id/cartPricePerItem"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:id="@+id/old_price_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textFontWeight="400"
        app:layout_constraintBaseline_toBaselineOf="@+id/cartItemPrice"
        app:layout_constraintStart_toEndOf="@+id/cartItemPrice"/>
    <View
        android:id="@+id/old_price_crossing_line"
        android:background="@color/monza"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:rotation="-18"
        app:layout_constraintBottom_toBottomOf="@+id/old_price_label"
        app:layout_constraintEnd_toEndOf="@+id/old_price_label"
        app:layout_constraintStart_toStartOf="@+id/old_price_label"
        app:layout_constraintTop_toTopOf="@+id/old_price_label"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/horizontalBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="image, cartItemPrice"/>
    <View
        android:id="@+id/separator"
        android:background="@color/gray400"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="15dp"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/horizontalBarrier"/>
</androidx.constraintlayout.widget.ConstraintLayout>
