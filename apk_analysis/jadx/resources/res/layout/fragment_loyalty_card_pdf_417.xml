<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_content"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageButton
        android:id="@+id/close_button"
        android:background="@android:color/transparent"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="13dp"
        android:src="@drawable/btn_close_simple_cross"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/title_guide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="48dp"/>
    <TextView
        android:textAppearance="@style/Home.CategoryBlockTitle"
        android:gravity="center"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rotation="90"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/title_guide"
        app:layout_constraintStart_toStartOf="@+id/title_guide"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/number_guide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="82dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rotation="90"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/number_guide"
        app:layout_constraintStart_toStartOf="@+id/number_guide"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="18sp"
            android:textStyle="normal"
            android:textColor="@color/defaultLabelTextColor"
            android:gravity="center"
            android:id="@+id/number_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/title_guide"
            app:layout_constraintStart_toStartOf="@+id/title_guide"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageButton
            android:id="@+id/copy_number_button"
            android:background="@android:color/transparent"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/btn_copy"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/qr_image"
        android:layout_width="473dp"
        android:layout_height="117dp"
        android:rotation="90"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/advantages_guide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="61dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#00975f"
        android:id="@+id/advantages_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Преимущества вашей карты АШАН &gt;"
        android:rotation="90"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/advantages_guide"
        app:layout_constraintStart_toStartOf="@+id/advantages_guide"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
