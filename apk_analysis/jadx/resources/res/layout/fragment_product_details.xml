<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/defaultLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetStart="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/back_button"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/ToolbarImageButton.Back"/>
                <View
                    android:id="@+id/scrolled_line_view"
                    android:background="@color/catskill_white"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <ImageView
                    android:id="@+id/share_button"
                    android:background="@drawable/ic_share"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/favorite_button"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/favorite_button"
                    android:background="@drawable/ic_favorite_empty"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.Toolbar>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_view"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingBottom="33dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/out_of_stock_top_layout"
                        android:background="@color/gray200"
                        android:paddingBottom="32dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textAppearance="@style/TextAppearance.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Товар закончился"
                            android:layout_marginHorizontal="20dp"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/out_of_stock_card"
                            android:background="@drawable/bg_rounded_12"
                            android:padding="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:elevation="10dp"
                            android:layout_marginHorizontal="20dp">
                            <ImageView
                                android:id="@+id/out_of_stock_card_image"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textAppearance="@style/TextAppearance.Subhead2Bold"
                                android:textColor="@color/gray600"
                                android:ellipsize="end"
                                android:id="@+id/out_of_stock_card_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:layout_marginStart="8dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/out_of_stock_card_image"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textAppearance="@style/TextAppearance.Subhead2Bold"
                                android:textColor="@color/gray600"
                                android:id="@+id/out_of_stock_card_price"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="@+id/out_of_stock_card_title"
                                app:layout_constraintTop_toBottomOf="@+id/out_of_stock_card_title"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <p000auchan.RecommendationsView
                            android:id="@+id/top_recommendations_container"
                            android:background="@color/gray200"
                            android:paddingTop="32dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:always_hide_divider="true"
                            app:section_left_margin="20dp"
                            app:section_right_margin="20dp"/>
                    </LinearLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/product_images_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <helper.TouchListenerViewGroup
                                android:id="@+id/product_images_touch_intercept"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <androidx.viewpager2.widget.ViewPager2
                                    android:id="@+id/product_images"
                                    android:clipChildren="false"
                                    android:clipToPadding="false"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:paddingStart="20dp"
                                    android:paddingEnd="20dp"/>
                            </helper.TouchListenerViewGroup>
                        </LinearLayout>
                        <androidx.cardview.widget.CardView
                            android:id="@+id/productImagesIndicatorContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:layout_marginEnd="20dp"
                            android:stateListAnimator="@null"
                            android:backgroundTint="@color/gray200"
                            app:cardCornerRadius="8dp"
                            app:layout_constraintBottom_toBottomOf="@+id/product_images_section"
                            app:layout_constraintEnd_toEndOf="parent">
                            <me.relex.circleindicator.CircleIndicator
                                android:id="@+id/product_images_indicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="4dp"
                                app:ci_animator="@animator/no_op"
                                app:ci_drawable="@drawable/ic_pager_indicator_active_gray900_2dp"
                                app:ci_drawable_unselected="@drawable/ic_pager_indicator_inactive_gray400_2dp"
                                app:ci_height="4dp"
                                app:ci_margin="2dp"
                                app:ci_width="4dp"/>
                        </androidx.cardview.widget.CardView>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/salesLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <p000auchan.BadgesView
                                android:id="@+id/badgesLayout"
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"/>
                        </LinearLayout>
                        <androidx.recyclerview.widget.RecyclerView
                            android:orientation="horizontal"
                            android:id="@+id/brandsAndCategories"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/product_images_section"/>
                        <TextView
                            android:textSize="20sp"
                            android:textColor="@color/basics700"
                            android:gravity="center"
                            android:id="@+id/title_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:lineSpacingExtra="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/brandsAndCategories"/>
                        <View
                            android:id="@+id/in_sale_group_top_margin"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            app:layout_constraintTop_toBottomOf="@+id/title_label"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/smallRateSection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/in_sale_group_top_margin">
                            <ImageView
                                android:id="@+id/smallRateStarView"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_star_gold"
                                android:translationY="1dp"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/basics700"
                                android:id="@+id/smallRateRatingTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="4dp"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/primary02_TextActive"
                                android:id="@+id/smallRateReviewCountTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="6dp"/>
                            <p000auchan.ReviewRewardStickerView
                                android:id="@+id/reviewRewardSticker"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/rate_price_spacer"
                            android:layout_width="match_parent"
                            android:layout_height="24dp"
                            app:layout_constraintTop_toBottomOf="@+id/smallRateSection"/>
                        <TextView
                            android:textAppearance="@style/TextAppearance.Body2Medium"
                            android:textColor="@color/primary500"
                            android:id="@+id/discountByTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/rate_price_spacer"/>
                        <TextView
                            android:textAppearance="@style/TextAppearance.Body2Medium"
                            android:textColor="@color/text_secondary"
                            android:id="@+id/in_sale_date_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            app:layout_constraintBaseline_toBaselineOf="@+id/discountByTextView"
                            app:layout_constraintStart_toEndOf="@+id/discountByTextView"/>
                        <TextView
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/basics700"
                            android:id="@+id/price_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/in_sale_date_label"/>
                        <androidx.constraintlayout.widget.Group
                            android:id="@+id/old_price_group"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="old_price_label,old_price_crossing_line"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/text_secondary"
                            android:id="@+id/old_price_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:layout_marginStart="4dp"
                            app:layout_constraintBaseline_toBaselineOf="@+id/price_label"
                            app:layout_constraintStart_toEndOf="@+id/price_label"/>
                        <View
                            android:id="@+id/old_price_crossing_line"
                            android:background="@color/torch_red"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:rotation="-18"
                            app:layout_constraintBottom_toBottomOf="@+id/old_price_label"
                            app:layout_constraintEnd_toEndOf="@+id/old_price_label"
                            app:layout_constraintStart_toStartOf="@+id/old_price_label"
                            app:layout_constraintTop_toTopOf="@+id/old_price_label"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:id="@+id/unit_type_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginStart="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/price_label"/>
                        <View
                            android:id="@+id/stock_label_spacing"
                            android:layout_width="match_parent"
                            android:layout_height="16dp"
                            app:layout_constraintTop_toBottomOf="@+id/unit_type_label"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/green_counter"
                            android:id="@+id/stock_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/stock_label_spacing"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/collectible_snack"
                            android:background="@drawable/bg_snack_basics200"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:visibility="visible"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="10dp"
                            android:layout_marginHorizontal="20dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/stock_label">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/basics700"
                                android:id="@+id/collectible_snack_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:lineSpacingExtra="3sp"/>
                        </LinearLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/available_shops_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/collectible_snack"
                            app:layout_goneMarginTop="8dp">
                            <TextView
                                android:textSize="12dp"
                                android:textColor="@color/black"
                                android:id="@+id/available_in_shop_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                style="@style/InfoItemLabel"/>
                            <ImageView
                                android:id="@+id/chevronImageDown"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_chevron_down_gray_24"
                                app:layout_constraintBottom_toBottomOf="@+id/available_in_shop_label"
                                app:layout_constraintRight_toRightOf="parent"
                                app:layout_constraintTop_toTopOf="@+id/available_in_shop_label"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/shopsListView"
                            android:visibility="gone"
                            android:scrollbars="none"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/available_shops_button"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/delayed_cashback_snack"
                            android:background="@drawable/bg_snack_gray200"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:visibility="visible"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:layout_marginHorizontal="20dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/shopsListView">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="8dp"
                                android:src="@drawable/ic_delayed_bonuses_info"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/basics700"
                                android:id="@+id/delayed_cashback_snack_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:lineSpacingExtra="3sp"/>
                        </LinearLayout>
                        <crc64fac7521b55e1fcf3.SnackView
                            android:id="@+id/age_snackLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            app:cellBackground="@drawable/bg_snack_primary01"
                            app:cellIcon="@drawable/ic_snackbar_warning_small"
                            app:cellTextColor="@color/text_secondary"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/delayed_cashback_snack"/>
                        <crc64fac7521b55e1fcf3.SnackView
                            android:id="@+id/pickup_snackLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            app:cellBackground="@drawable/bg_snack_blue"
                            app:cellIcon="@drawable/ic_info_blue_small"
                            app:cellTextColor="@color/text_secondary"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/age_snackLayout"/>
                        <crc64fac7521b55e1fcf3.SnackView
                            android:id="@+id/is_bad_habit_snackText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            app:cellBackground="@drawable/bg_snack_basics150"
                            app:cellIcon="@drawable/ic_info_small"
                            app:cellTextColor="@color/basics600"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/pickup_snackLayout"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/modifications_list"
                            android:scrollbars="none"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/is_bad_habit_snackText"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/gluings_list"
                            android:scrollbars="none"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/modifications_list"/>
                        <Auchan.Android.Catalog.ProductDetails.ProductDetailsNutrientsView
                            android:id="@+id/nutrients_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/gluings_list"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/product_details_button"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:foregroundGravity="center_vertical"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/nutrients_view">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/basics700"
                                android:layout_gravity="start|center_vertical"
                                android:id="@+id/product_details_button_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Подробнее о товаре"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif"
                                android:lineHeight="20sp"
                                android:textFontWeight="500"/>
                            <ImageView
                                android:layout_gravity="end|center_vertical"
                                android:id="@+id/product_details_button_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_chevron_down_gray_24"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/product_details_layout"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/product_details_button">
                            <p000auchan.CollapsableTextView
                                android:textSize="14sp"
                                android:textColor="@color/basics600"
                                android:id="@+id/description_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="24dp"
                                android:lineSpacingExtra="4dp"
                                android:layout_marginStart="20dp"
                                android:layout_marginEnd="20dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <View
                                android:background="@color/gray200"
