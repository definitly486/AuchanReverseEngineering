    <include
        android:id="@+id/errorLayout"
        android:visibility="gone"
        layout="@layout/error"/>
    <include
        android:id="@+id/progressLayout"
        android:visibility="gone"
        layout="@layout/progress"/>
    <include
        android:id="@+id/emptyLayout"
        android:visibility="gone"
        layout="@layout/empty_goods_in_category"/>
</FrameLayout>
