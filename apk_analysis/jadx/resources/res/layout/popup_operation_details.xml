<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/basics100"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shapeAppearance="@style/TopCornersShape">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/default_view"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="44dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/puller"
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/bottom_sheet_line"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/basics700"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="30dp"/>
            <ImageView
                android:id="@+id/close_button"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_close_dark"
                android:layout_weight="0"/>
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollIndicators="none">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/icon_background"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="39dp"
                    app:cardElevation="16dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"/>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/description_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="63dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toTopOf="@+id/store_name"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:paddingBottom="24dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/basics700"
                            android:gravity="center"
                            android:id="@+id/value_label"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginTop="55dp"
                            app:layout_constraintBottom_toTopOf="@+id/purchase_points_layout"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toLeftOf="@+id/value_icon"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:id="@+id/value_icon"
                            android:visibility="gone"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_marginLeft="8dp"
                            android:translationY="1dp"
                            app:layout_constraintBottom_toBottomOf="@+id/value_label"
                            app:layout_constraintLeft_toRightOf="@+id/value_label"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/value_label"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/purchase_points_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:divider="@drawable/loyalty_purchase_points_divider"
                            android:showDividers="middle"
                            app:layout_constraintBottom_toTopOf="@+id/time_label"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/value_label">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/purchase_points"
                                android:background="@color/basics100"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="12dp"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="0dp">
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:paddingHorizontal="6dp">
                                    <TextView
                                        android:textSize="14sp"
                                        android:textColor="@color/basics700"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:id="@+id/purchase_points_value"
                                        android:layout_width="wrap_content"
                                        android:layout_height="20dp"
                                        android:fontFamily="sans-serif-medium"/>
                                    <ImageView
                                        android:layout_gravity="center"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginLeft="4dp"
                                        android:src="@drawable/ic_loyalty_point"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/purchase_e_points"
                                android:background="@color/basics100"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="12dp"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="0dp">
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:paddingHorizontal="6dp">
                                    <TextView
                                        android:textSize="14sp"
                                        android:textColor="@color/basics700"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:id="@+id/purchase_e_points_value"
                                        android:layout_width="wrap_content"
                                        android:layout_height="20dp"
                                        android:fontFamily="sans-serif-medium"/>
                                    <ImageView
                                        android:layout_gravity="center"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginLeft="4dp"
                                        android:src="@drawable/ic_loyalty_e_point"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/basics500"
                            android:gravity="center"
                            android:id="@+id/time_label"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:layout_marginTop="4dp"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/purchase_points_layout"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/basics600"
                    android:gravity="center_vertical"
                    android:id="@+id/store_name"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toTopOf="@+id/store_address"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/description_background"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/basics500"
                    android:gravity="center_vertical"
                    android:id="@+id/store_address"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintBottom_toTopOf="@+id/map_card_view"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/store_name"/>
                <com.google.android.material.card.MaterialCardView
                    android:enabled="false"
                    android:id="@+id/map_card_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="174dp"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/store_address"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <include
        android:id="@+id/errorLayout"
        android:visibility="gone"
        layout="@layout/comarch_error_view"/>
</com.google.android.material.card.MaterialCardView>
