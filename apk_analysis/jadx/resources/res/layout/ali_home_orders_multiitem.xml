<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="20dp"
    app:cardBackgroundColor="#ffffff"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/orderListCellControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/layout_order_item_card"/>
        <include
            android:id="@+id/addToOrderControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="12dp"
            layout="@layout/layout_add_to_order_button_small"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="14sp"
            android:layout_gravity="center_horizontal"
            android:id="@+id/button_get_orders"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:text="Забрать заказ"
            android:layout_marginHorizontal="12dp"
            app:cornerRadius="8dp"
            style="@style/DefaultGreenMaterialRoundButtonS"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="14sp"
            android:layout_gravity="center_horizontal"
            android:id="@+id/button_pay_order"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:text="Оплатить заказ"
            android:layout_marginHorizontal="12dp"
            app:cornerRadius="8dp"
            style="@style/DefaultGreenMaterialRoundButtonS"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp">
            <com.google.android.material.button.MaterialButton
                android:ellipsize="end"
                android:id="@+id/repeatButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="12dp"
                android:lines="1"
                android:layout_marginHorizontal="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/callToCourierButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/DefaultGrayMaterialRoundButtonS"/>
            <com.google.android.material.button.MaterialButton
                android:ellipsize="end"
                android:id="@+id/callToCourierButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="12dp"
                android:lines="1"
                android:layout_marginHorizontal="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/repeatButton"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/DefaultGreenMaterialRoundButtonS"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
